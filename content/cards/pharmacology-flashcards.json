  "pharmacology__Cardiovascular Drugs__Antihypertensives": [
   {
    "id": "ph_cvs_htn_ex01",
    "front": "What is the mechanism of ACE inhibitors (e.g. ramipril)?",
    "back": "Block angiotensin-converting enzyme → less angiotensin II → vasodilation + less aldosterone → lower BP. Reduced bradykinin breakdown causes the dry cough."
   },
   {
    "id": "ph_cvs_htn_ex02",
    "front": "An ACE inhibitor causes an intolerable dry cough. What is the switch?",
    "back": "An ARB (e.g. losartan, candesartan) — same RAAS blockade without bradykinin accumulation, so the cough settles."
   },
   {
    "id": "ph_cvs_htn_ex03",
    "front": "Which antihypertensive class classically causes ankle oedema?",
    "back": "Dihydropyridine calcium-channel blockers (e.g. amlodipine)."
   }
  ],
