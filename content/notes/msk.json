{"MSK__Joint Pain": "<div class=\"cp\"><div class=\"cp\"><style>.cp *{box-sizing:border-box;}.cp{font-family:var(--sans,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif);color:var(--rn-text,#1E2640);line-height:1.5;}.cp-lead{font-size:14px;line-height:1.75;color:var(--rn-sub,#5A6480);margin:2px 0 14px;background:var(--rn-card,#fff);border:1.5px solid var(--rn-border,#E2E6F0);border-radius:12px;padding:16px 18px;box-shadow:0 1px 4px rgba(0,0,0,.05);}.cp-lead b{color:var(--rn-text,#1E2640);}.cp-warn{display:flex;gap:10px;background:var(--rn-red-bg,#FDEAEA);border:1.5px solid #F2BABA;color:var(--rn-text,#1E2640);border-radius:10px;padding:14px 18px;font-size:13.5px;line-height:1.7;margin-bottom:12px;}.cp-warn b{color:var(--rn-red,#C93535);}.cp-warn .cp-warn-ic{font-size:16px;line-height:1.4;}.cp-step{margin-bottom:12px;background:var(--rn-card,#fff);border:1.5px solid var(--rn-border,#E2E6F0);border-radius:12px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.05);}.cp-step-h{display:flex;align-items:center;gap:11px;padding:12px 20px;border-bottom:1.5px solid var(--rn-border,#E2E6F0);background:var(--rn-blue-bg,#EBF2FF);}.cp-step-body{padding:20px;}.cp-step-body>.cp-sub:first-child{margin-top:0;}.cp-num{flex:none;width:24px;height:24px;border-radius:50%;background:var(--rn-blue,#3B7DD8);color:#fff;font-size:13px;font-weight:800;display:flex;align-items:center;justify-content:center;font-family:var(--mono,'SF Mono',SFMono-Regular,ui-monospace,Menlo,Consolas,monospace);}.cp-title{font-family:var(--mono,'SF Mono',SFMono-Regular,ui-monospace,Menlo,Consolas,monospace);font-size:12px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--rn-blue,#3B7DD8);}.cp-killgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(215px,1fr));gap:11px;}.cp-kill{border:1px solid var(--rn-border,#E2E6F0);border-left:4px solid var(--kc,var(--rn-blue,#3B7DD8));border-radius:11px;padding:0;overflow:hidden;background:var(--rn-card,#fff);}.cp-kill-top{display:flex;align-items:center;gap:8px;padding:9px 13px;background:var(--kcb,var(--rn-blue-bg,#EBF2FF));border-bottom:1px solid var(--rn-border,#E2E6F0);}.cp-kill-ic{font-size:15px;}.cp-kill-name{font-size:14px;font-weight:800;color:var(--kc,var(--rn-text,#1E2640));}.cp-kill-desc{padding:11px 13px;font-size:12.5px;line-height:1.5;color:var(--rn-sub,#5A6480);}.cp-kill .cp-dx{margin-top:9px;}.cp-clue{display:flex;align-items:center;gap:12px;padding:11px 2px;border-bottom:1px solid var(--rn-border,#EEF1F7);}.cp-clue:last-child{border-bottom:none;}.cp-when{flex:1 1 44%;font-size:13.5px;font-weight:700;color:var(--rn-text,#1E2640);}.cp-arrow{flex:none;color:var(--rn-blue,#3B7DD8);font-weight:700;}.cp-then{flex:1 1 52%;display:flex;flex-wrap:wrap;gap:6px;}.cp-bed{padding:12px 14px;border-radius:10px;background:#F1F3F8;border:1.5px solid var(--rn-border,#E2E6F0);margin-bottom:8px;}.cp-bed-hot{background:var(--rn-red-bg,#FDEAEA);border-color:#F2BABA;}.cp-bed-h{display:flex;align-items:baseline;gap:8px;margin-bottom:7px;}.cp-bed-n{font-family:var(--mono,'SF Mono',SFMono-Regular,ui-monospace,Menlo,Consolas,monospace);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--rn-text,#1E2640);}.cp-bed-hot .cp-bed-n{color:var(--rn-red,#C93535);}.cp-bed-when{font-size:11px;color:var(--rn-muted,#9AA4B2);font-style:italic;}.cp-reads{display:flex;flex-wrap:wrap;gap:6px;}.cp-read{font-size:11.5px;line-height:1.35;background:var(--rn-card,#fff);border:1px solid var(--rn-border,#E2E6F0);border-radius:7px;padding:4px 9px;color:var(--rn-sub,#5A6480);}.cp-read b{color:var(--rn-text,#1E2640);font-weight:700;}.cp-read .cp-ar{color:var(--rn-blue,#3B7DD8);}.cp-bed-hot .cp-read{border-color:#F3B7B7;}.cp-sub{font-family:var(--mono,'SF Mono',SFMono-Regular,ui-monospace,Menlo,Consolas,monospace);font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--rn-text,#1E2640);margin:16px 0 10px;}.cp-confirm{display:flex;flex-wrap:wrap;gap:7px;}.cp-cfm{font-size:12px;line-height:1.4;background:var(--rn-blue-bg,#EBF2FF);border:1px solid #D6E4FA;border-radius:8px;padding:5px 10px;}.cp-cfm .cp-dxn{font-weight:800;color:var(--rn-text,#1E2640);}.cp-cfm .cp-ar{color:var(--rn-blue,#3B7DD8);}.cp-cfm .cp-tst{color:var(--rn-blue,#3B7DD8);font-weight:600;}.cp-pearl{background:var(--rn-yellow-bg,#FFFBE6);border:1.5px solid #E8D48A;border-left:4px solid var(--rn-yellow,#8A6C00);border-radius:0 10px 10px 0;padding:12px 16px;font-size:13.5px;line-height:1.6;color:var(--rn-text,#1E2640);margin-top:14px;}.cp-pearl b{color:var(--rn-text,#1E2640);}.cp-sysgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(255px,1fr));gap:11px;}.cp-sys{border:1px solid var(--rn-border,#E2E6F0);border-left:4px solid;border-radius:11px;padding:12px 14px;background:var(--rn-card,#fff);}.cp-sys.tier-red{border-left-color:var(--rn-red,#C93535);}.cp-sys.tier-amber{border-left-color:var(--rn-amber,#B86B00);}.cp-sys.tier-green{border-left-color:var(--rn-green,#1F8B5E);}.cp-sys-h{font-family:var(--mono,'SF Mono',SFMono-Regular,ui-monospace,Menlo,Consolas,monospace);font-size:11px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--rn-text,#1E2640);margin-bottom:9px;}.cp-sys-dx{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px;}.cp-sys-d{font-size:12px;line-height:1.45;color:var(--rn-sub,#5A6480);}.cp-dx{display:inline-block;font-size:12.5px;font-weight:600;text-decoration:none;padding:3px 10px;border-radius:999px;background:var(--rn-blue-bg,#EBF2FF);color:var(--rn-blue,#3B7DD8);border:1px solid transparent;transition:all .13s;}.cp-dx:hover{border-color:var(--rn-blue,#3B7DD8);}.cp-dx-off{background:#F1F3F8;color:var(--rn-sub,#7A8396);}.cp-hand{display:flex;gap:10px;background:var(--rn-blue-bg,#EBF2FF);border:1.5px solid #B0CCEF;border-radius:10px;padding:14px 18px;font-size:13.5px;line-height:1.7;color:var(--rn-text,#1E2640);margin-top:26px;}.cp-hand b{color:var(--rn-blue,#3B7DD8);}.cp-mapic{font-size:18px;line-height:1;}.cp-flow{display:flex;flex-direction:column;align-items:center;text-align:center;}.cp-dn{color:var(--rn-border,#C7CEDB);font-size:13px;line-height:1;margin:5px 0;}.cp-node{border-radius:11px;padding:10px 18px;font-weight:700;font-size:13.5px;max-width:560px;background:var(--rn-card,#fff);border:1.5px solid var(--rn-border,#E2E6F0);color:var(--rn-text,#1E2640);}.cp-node.start{background:var(--rn-blue-bg,#EBF2FF);border-color:#B0CCEF;color:var(--rn-blue,#3B7DD8);font-weight:800;letter-spacing:.06em;}.cp-node.danger{background:var(--rn-red-bg,#FDEAEA);border-color:#EDBFBF;color:var(--rn-red,#C93535);}.cp-node-sub{font-weight:500;font-size:10.5px;margin-top:3px;opacity:.9;}.cp-flowlabel{font-size:11px;color:var(--rn-muted,#9AA4B2);font-style:italic;margin:6px 0;}.cp-node.decision{background:var(--rn-amber-bg,#FEF5E4);border-color:#E8CE93;color:var(--rn-amber,#B86B00);}.cp-node.work{background:var(--rn-blue-bg,#EBF2FF);border-color:#B0CCEF;color:var(--rn-blue,#3B7DD8);font-weight:800;}.cp-node.final{background:var(--rn-blue-bg,#EBF2FF);border-color:#B7CEF0;color:var(--rn-blue,#3B7DD8);}.cp-branchbox{width:100%;border:1.5px dashed var(--rn-border,#D8DEEA);border-radius:14px;padding:14px 12px;background:transparent;}.cp-branchcols{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;}.cp-col{display:flex;flex-direction:column;align-items:center;flex:1 1 128px;max-width:150px;}.cp-feat{font-size:11px;font-weight:600;background:#F1F3F8;border:1px solid var(--rn-border,#E2E6F0);border-radius:8px;padding:6px 8px;width:100%;min-height:42px;display:flex;align-items:center;justify-content:center;color:var(--rn-sub,#5A6480);}.cp-cdn{color:var(--rn-border,#C7CEDB);font-size:10px;margin:3px 0;}.cp-dx-node{font-size:12px;font-weight:800;border-radius:8px;padding:7px 8px;width:100%;border:1px solid;text-decoration:none;}.cp-dx-node.tier-red{background:var(--rn-red-bg,#FDEAEA);border-color:#EDC6C6;color:var(--rn-red,#C93535);}.cp-dx-node.tier-amber{background:var(--rn-amber-bg,#FEF5E4);border-color:#EAD4A4;color:var(--rn-amber,#B86B00);}.cp-dx-node.tier-green{background:var(--rn-green-bg,#E6F6EF);border-color:#B9E2CD;color:var(--rn-green,#1F8B5E);}.cp-test{font-size:10.5px;color:var(--rn-sub,#7A8396);font-weight:600;margin-top:5px;}.cp-dxlink{display:block;text-decoration:none;cursor:pointer;}.cp-dxlink:hover{box-shadow:0 0 0 2px currentColor inset;}</style><div class=\"cp-lead\"><b>Joint pain (arthralgia)</b> is one of the commonest presenting symptoms &mdash; and the trick is a <b>structured sort</b> before you reach for tests. Ask four questions. <b>(1) Articular or periarticular?</b> &mdash; is the <b>joint itself</b> painful (pain on all movement, effusion, deep/diffuse) or a <b>tendon / bursa / bone</b> around it (point tenderness, pain on one movement)? <b>(2) Inflammatory or mechanical?</b> &mdash; <b>inflammatory</b> = early-morning stiffness <b>&gt;30&ndash;60&nbsp;min</b>, <b>eases with use</b>, swelling / warmth / erythema, night pain, systemic upset; <b>mechanical / degenerative</b> = worse <b>through the day / with use</b>, stiffness <b>&lt;30&nbsp;min</b>, better with rest. <b>(3) What pattern?</b> &mdash; <b>mono</b> (1) vs <b>oligo</b> (2&ndash;4) vs <b>poly</b> (&ge;5), symmetry, large vs small, axial vs peripheral, migratory vs additive (see <a class=\"cp-dx\" href=\"#signs/MSK/Monoarthritis\">monoarthritis</a>, <a class=\"cp-dx\" href=\"#signs/MSK/Polyarthritis\">polyarthritis</a>). <b>(4) Acute or chronic?</b></div><div class=\"cp-warn\"><span class=\"cp-warn-ic\">🚨</span><span>A <b>single acute hot, swollen, painful joint</b> is <b>septic arthritis until proven otherwise</b> &mdash; <b>aspirate the joint</b> (before antibiotics if possible) and do not delay (see <a class=\"cp-dx\" href=\"#signs/MSK/Acute Hot Swollen Joint\">hot swollen joint</a>, <a class=\"cp-dx\" href=\"#conditions/MSK%20%2F%20RHEUMATOLOGY/Bone%20%26%20Joint%20Infection\">bone &amp; joint infection</a>). Also flagged: <b>fever with systemic upset</b>, joint pain with a <b>rash / photosensitivity, oral ulcers or red eye</b> (connective tissue disease / spondyloarthropathy), <b>new inflammatory arthritis with weight loss or night sweats</b> (malignancy / vasculitis), and any joint pain <b>after trauma</b> (fracture).</span></div><div style=\"font-size:22px;\"><div style=\"font-size:22px;\">📷</div><div style=\"font-size:12.5px;font-weight:700;\">Image placeholder &mdash; the joint-pain sort: articular vs periarticular, inflammatory vs mechanical clock (morning stiffness), and the mono / oligo / poly &amp; symmetry patterns that steer the differential</div><div style=\"font-family:var(--mono);font-size:10.5px;text-transform:uppercase;letter-spacing:.05em;color:var(--rn-muted,#9AA4B2);margin-top:10px;\">link to be uploaded</div></div><div class=\"cp-step\" id=\"s-1\"><div class=\"cp-step-h\"><span class=\"cp-num\">1</span><span class=\"cp-title\">Recognise &amp; sort</span></div><div class=\"cp-step-body\"><div class=\"cp-killgrid\"><div class=\"cp-kill\" style=\"--kc:var(--rn-blue,#3B7DD8);--kcb:var(--rn-blue-bg,#EBF2FF);\"><div class=\"cp-kill-top\"><span class=\"cp-kill-ic\">🔍</span><span class=\"cp-kill-name\">Take the pain apart</span></div><div class=\"cp-kill-desc\"><ul style=\"margin:6px 0 0;padding-left:17px;list-style:disc;\"><li style=\"margin:3px 0;\"><b>Articular</b> (pain on all movement, effusion) vs <b>periarticular</b> (point tenderness, pain on one specific movement &mdash; tendon / bursa)</li><li style=\"margin:3px 0;\"><b>Inflammatory</b> (morning stiffness &gt;30&ndash;60&nbsp;min, eases with use, hot / swollen, night pain) vs <b>mechanical</b> (worse with use, stiffness &lt;30&nbsp;min, eases with rest)</li><li style=\"margin:3px 0;\">Define <b>onset (acute vs chronic)</b>, <b>number of joints</b>, <b>symmetry</b>, and whether it is <b>migratory or additive</b></li></ul></div></div><div class=\"cp-kill\" style=\"--kc:var(--rn-red,#C93535);--kcb:var(--rn-red-bg,#FDEAEA);\"><div class=\"cp-kill-top\"><span class=\"cp-kill-ic\">🚩</span><span class=\"cp-kill-name\">Red-flag patterns</span></div><div class=\"cp-kill-desc\"><ul style=\"margin:6px 0 0;padding-left:17px;list-style:disc;\"><li style=\"margin:3px 0;\"><b>Single acute hot swollen joint</b> &rarr; <b>septic arthritis until proven otherwise</b> &mdash; <b>aspirate</b> (see <a class=\"cp-dx\" href=\"#conditions/MSK%20%2F%20RHEUMATOLOGY/Bone%20%26%20Joint%20Infection\">joint infection</a>)</li><li style=\"margin:3px 0;\"><b>Fever / systemic upset</b>, or arthritis with a <b>rash, oral ulcers, red eye or new murmur</b> (CTD, spondyloarthropathy, endocarditis)</li><li style=\"margin:3px 0;\"><b>New inflammatory arthritis + weight loss / night sweats</b> (malignancy / vasculitis); any <b>post-traumatic</b> joint pain (fracture)</li></ul></div></div><div class=\"cp-kill\" style=\"--kc:var(--rn-green,#1F8B5E);--kcb:var(--rn-green-bg,#E6F6EF);\"><div class=\"cp-kill-top\"><span class=\"cp-kill-ic\">🔵</span><span class=\"cp-kill-name\">Acute patterns</span></div><div class=\"cp-kill-desc\"><ul style=\"margin:6px 0 0;padding-left:17px;list-style:disc;\"><li style=\"margin:3px 0;\"><b>Acute monoarthritis</b>: <b>septic</b> arthritis, <b>gout</b> / <b>pseudogout</b> (see <a class=\"cp-dx\" href=\"#conditions/MSK%20%2F%20RHEUMATOLOGY/Crystal%20Arthropathies\">crystal arthropathy</a>), haemarthrosis, trauma</li><li style=\"margin:3px 0;\"><b>Migratory</b> (moves joint to joint): gonococcal, rheumatic fever, viral, Lyme, early connective tissue disease</li><li style=\"margin:3px 0;\"><b>Acute symmetrical small-joint</b> polyarthritis: viral (e.g. parvovirus), early rheumatoid arthritis</li></ul></div></div><div class=\"cp-kill\" style=\"--kc:var(--rn-amber,#B86B00);--kcb:var(--rn-amber-bg,#FEF5E4);\"><div class=\"cp-kill-top\"><span class=\"cp-kill-ic\">🟢</span><span class=\"cp-kill-name\">Chronic patterns</span></div><div class=\"cp-kill-desc\"><ul style=\"margin:6px 0 0;padding-left:17px;list-style:disc;\"><li style=\"margin:3px 0;\"><b>Symmetrical small joints (MCP / PIP / wrist), morning stiffness</b> &rarr; <b>rheumatoid arthritis</b> (see <a class=\"cp-dx\" href=\"#conditions/MSK%20%2F%20RHEUMATOLOGY/Rheumatoid%20Arthritis\">RA</a>)</li><li style=\"margin:3px 0;\"><b>Asymmetrical large joints / axial + enthesitis / dactylitis</b> &rarr; <b>spondyloarthropathy</b> (psoriatic, reactive, axial, IBD-related, see <a class=\"cp-dx\" href=\"#conditions/MSK%20%2F%20RHEUMATOLOGY/Seronegative%20Spondyloarthropathies\">spondyloarthropathy</a>)</li><li style=\"margin:3px 0;\"><b>DIP + weight-bearing joints, worse with use, bony swelling</b> &rarr; <b>osteoarthritis</b> (see <a class=\"cp-dx\" href=\"#conditions/MSK%20%2F%20RHEUMATOLOGY/Osteoarthritis\">OA</a>)</li></ul></div></div><div class=\"cp-kill\" style=\"--kc:var(--rn-purple,#6B45B8);--kcb:var(--rn-purple-bg,#F0EBFF);\"><div class=\"cp-kill-top\"><span class=\"cp-kill-ic\">🟣</span><span class=\"cp-kill-name\">Don&rsquo;t-miss systemic clues</span></div><div class=\"cp-kill-desc\"><ul style=\"margin:6px 0 0;padding-left:17px;list-style:disc;\"><li style=\"margin:3px 0;\"><b>Photosensitive rash, oral ulcers, Raynaud&rsquo;s, serositis</b> &rarr; <b>connective tissue disease / SLE</b> (see <a class=\"cp-dx\" href=\"#conditions/MSK%20%2F%20RHEUMATOLOGY/Connective%20Tissue%20Diseases\">CTD</a>)</li><li style=\"margin:3px 0;\"><b>Psoriasis / nail changes, uveitis, urethritis or recent diarrhoea, IBD</b> &rarr; a <b>spondyloarthropathy</b></li><li style=\"margin:3px 0;\"><b>Widespread pain, tender points, fatigue, non-inflammatory</b> &rarr; <b>fibromyalgia</b> (a diagnosis of exclusion, see <a class=\"cp-dx\" href=\"#conditions/MSK%20%2F%20RHEUMATOLOGY/Fibromyalgia\">fibromyalgia</a>)</li><li style=\"margin:3px 0;\"><b>Over-50s, proximal shoulder / pelvic-girdle pain + long morning stiffness, very high ESR</b> &rarr; <b>polymyalgia rheumatica</b> (watch for <a class=\"cp-dx\" href=\"#conditions/MSK%20%2F%20RHEUMATOLOGY/Vasculitis\">giant cell arteritis</a>)</li></ul></div></div><div class=\"cp-kill\" style=\"--kc:var(--rn-blue,#3B7DD8);--kcb:var(--rn-blue-bg,#EBF2FF);\"><div class=\"cp-kill-top\"><span class=\"cp-kill-ic\">🩺</span><span class=\"cp-kill-name\">Assess &amp; investigate</span></div><div class=\"cp-kill-desc\"><ul style=\"margin:6px 0 0;padding-left:17px;list-style:disc;\"><li style=\"margin:3px 0;\">Examine with <b>look&ndash;feel&ndash;move</b>: effusion, warmth, deformity, range; screen the other joints, skin, nails and eyes</li><li style=\"margin:3px 0;\"><b>Bloods</b>: FBC, <b>CRP / ESR</b>, <b>urate</b>, <b>RF &amp; anti-CCP</b>, <b>ANA</b>, HLA-B27 (selectively), U&amp;E / LFTs</li><li style=\"margin:3px 0;\"><b>Joint aspiration</b> (MC&amp;S, <b>crystals</b>, Gram &mdash; mandatory for a hot joint) and <b>imaging</b> (X-ray, ultrasound / MRI) as guided</li></ul></div></div></div><div class=\"cp-pearl\"><b>Sort before you test.</b> Two questions do most of the work: is it <b>inflammatory or mechanical</b> (the <b>morning-stiffness clock</b> &mdash; &gt;30&ndash;60&nbsp;min and easing with use = inflammatory), and <b>how many joints, how symmetrical</b>? Those two axes place most arthritis before a single blood test &mdash; and a <b>single hot joint always gets aspirated</b> to exclude sepsis.</div></div></div><div class=\"cp-step\" id=\"s-2\"><div class=\"cp-step-h\"><span class=\"cp-num\">2</span><span class=\"cp-title\">What it points to</span></div><div class=\"cp-step-body\"><div class=\"cp-clues\"><div class=\"cp-clue\"><div class=\"cp-when\"><b>Single acute hot swollen joint</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/MSK%20%2F%20RHEUMATOLOGY/Bone%20%26%20Joint%20Infection\">Septic arthritis (aspirate) / crystal</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>1st MTP joint, sudden severe, red, at night</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/MSK%20%2F%20RHEUMATOLOGY/Crystal%20Arthropathies\">Gout</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Symmetrical MCP / PIP / wrist + morning stiffness</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/MSK%20%2F%20RHEUMATOLOGY/Rheumatoid%20Arthritis\">Rheumatoid arthritis</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>DIP + knees / hips, worse with use, bony nodes</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/MSK%20%2F%20RHEUMATOLOGY/Osteoarthritis\">Osteoarthritis</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Asymmetrical large joints / spine + psoriasis / dactylitis</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/MSK%20%2F%20RHEUMATOLOGY/Seronegative%20Spondyloarthropathies\">Spondyloarthropathy</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Arthralgia + photosensitive rash / oral ulcers / Raynaud&rsquo;s</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/MSK%20%2F%20RHEUMATOLOGY/Connective%20Tissue%20Diseases\">Connective tissue disease / SLE</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Migratory arthritis (joint to joint)</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><span class=\"cp-dx cp-dx-off\">Gonococcal / rheumatic fever / viral / Lyme</span></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Widespread pain + tender points, normal inflammatory markers</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/MSK%20%2F%20RHEUMATOLOGY/Fibromyalgia\">Fibromyalgia</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Proximal girdle pain + long stiffness + very high ESR in the over-50s</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/MSK%20%2F%20RHEUMATOLOGY/Vasculitis\">Polymyalgia rheumatica (&plusmn; GCA)</a></div></div></div><div class=\"cp-pearl\"><b>Hot joint = tap it.</b> Never attribute a single acutely hot, swollen joint to &ldquo;a flare of gout&rdquo; without excluding infection &mdash; <b>gout and sepsis can coexist</b>, and untreated septic arthritis destroys the joint within days. <b>Aspirate</b> for Gram stain, culture and crystals, ideally before antibiotics.</div></div></div><div class=\"cp-step\" id=\"s-3\"><div class=\"cp-step-h\"><span class=\"cp-num\">3</span><span class=\"cp-title\">Assess &amp; localise</span></div><div class=\"cp-step-body\"><div class=\"cp-sub\">At the bedside &mdash; characterise, examine, aspirate the hot joint</div><div class=\"cp-bed\"><div class=\"cp-bed-h\"><span class=\"cp-bed-n\">Characterise the pain</span></div><div class=\"cp-reads\"><span class=\"cp-read\"><b>Articular vs periarticular</b>, <b>inflammatory vs mechanical</b> (morning stiffness, response to use / rest), onset, and the <b>joint count / symmetry / migratory</b> pattern</span></div></div><div class=\"cp-bed\"><div class=\"cp-bed-h\"><span class=\"cp-bed-n\">Look – feel – move</span></div><div class=\"cp-reads\"><span class=\"cp-read\"><b>Effusion, warmth, erythema, deformity, nodes</b>; active &amp; passive <b>range</b>; then screen the <b>other joints, skin, nails and eyes</b> for a systemic clue</span></div></div><div class=\"cp-bed cp-bed-hot\"><div class=\"cp-bed-h\"><span class=\"cp-bed-n\">Aspirate the hot joint</span></div><div class=\"cp-reads\"><span class=\"cp-read\">A <b>single hot swollen joint</b> &rarr; <b>arthrocentesis</b> for <b>Gram stain, culture and crystals</b> &mdash; this is the decisive bedside step (see <a class=\"cp-dx\" href=\"#signs/MSK/Acute Hot Swollen Joint\">hot joint</a>)</span></div></div><div class=\"cp-bed\"><div class=\"cp-bed-h\"><span class=\"cp-bed-n\">Blood &amp; imaging work-up</span></div><div class=\"cp-reads\"><span class=\"cp-read\"><b>CRP / ESR, FBC, urate, RF / anti-CCP, ANA</b>, HLA-B27 selectively; <b>X-ray / ultrasound</b>; tailor to the pattern you found</span></div></div><div class=\"cp-sub\">Then &mdash; confirm the cause</div><div class=\"cp-confirm\"><span class=\"cp-cfm\"><span class=\"cp-dxn\">Septic arthritis</span> <span class=\"cp-ar\">&rarr;</span> <span class=\"cp-tst\"><b>joint aspirate</b> (Gram / culture)</span></span><span class=\"cp-cfm\"><span class=\"cp-dxn\">Gout / pseudogout</span> <span class=\"cp-ar\">&rarr;</span> <span class=\"cp-tst\"><b>aspirate crystals</b> (polarised light)</span></span><span class=\"cp-cfm\"><span class=\"cp-dxn\">Rheumatoid arthritis</span> <span class=\"cp-ar\">&rarr;</span> <span class=\"cp-tst\"><b>anti-CCP / RF</b> + ultrasound</span></span><span class=\"cp-cfm\"><span class=\"cp-dxn\">Osteoarthritis</span> <span class=\"cp-ar\">&rarr;</span> <span class=\"cp-tst\"><b>clinical</b> + X-ray</span></span><span class=\"cp-cfm\"><span class=\"cp-dxn\">Spondyloarthropathy</span> <span class=\"cp-ar\">&rarr;</span> <span class=\"cp-tst\"><b>MRI</b> SIJ + HLA-B27</span></span></div><div class=\"cp-pearl\"><b>The rules that carry it:</b> classify joint pain as <b>inflammatory vs mechanical</b> and by <b>number / symmetry of joints</b> &mdash; that places most arthritis. <b>Aspirate every single hot joint</b> to exclude sepsis. Then confirm with <b>targeted serology, crystals and imaging</b>, and open the condition note for management.</div></div></div><div class=\"cp-hand\" id=\"s-hand\"><span>➡️</span><span>Landed on a diagnosis? Open its <b>note</b> for investigations, management &amp; prognosis &mdash; every blue link above jumps straight there. <b>This is where the conditions library takes over.</b></span></div><div class=\"cp-step\" id=\"s-map\"><div class=\"cp-step-h\"><span class=\"cp-mapic\">🗺️</span><span class=\"cp-title\">In summary</span></div><div class=\"cp-step-body\"><div class=\"cp-flow\"><div class=\"cp-node start\">JOINT PAIN &mdash; articular or periarticular? inflammatory or mechanical? how many joints &amp; how symmetrical? acute or chronic?</div><div class=\"cp-dn\">▼</div><div class=\"cp-node danger\">Single hot swollen joint &rarr; septic arthritis until proven otherwise &rarr; ASPIRATE &middot; fever / rash / weight loss / trauma = red flags</div><div class=\"cp-dn\">▼</div><div class=\"cp-node decision\">Inflammatory (morning stiffness &gt;30&ndash;60 min, eases with use) vs mechanical (worse with use, stiffness &lt;30 min)</div><div class=\"cp-dn\">▼</div><div class=\"cp-node decision\">Pattern: mono (septic / crystal) &middot; symmetrical poly small-joint (RA) &middot; DIP + weight-bearing (OA) &middot; asymmetrical / axial (spondyloarthropathy)</div><div class=\"cp-dn\">▼</div><div class=\"cp-branchbox\"><div class=\"cp-branchcols\"><div class=\"cp-col\"><div class=\"cp-feat\">Single acute hot swollen joint</div><div class=\"cp-cdn\">▼</div><a href=\"#conditions/MSK%20%2F%20RHEUMATOLOGY/Bone%20%26%20Joint%20Infection\" class=\"cp-dx-node tier-red cp-dxlink\">Septic arthritis</a><div class=\"cp-cdn\">▼</div><div class=\"cp-test\">aspirate — Gram / culture</div></div><div class=\"cp-col\"><div class=\"cp-feat\">1st MTP, sudden, red, crystals on tap</div><div class=\"cp-cdn\">▼</div><a href=\"#conditions/MSK%20%2F%20RHEUMATOLOGY/Crystal%20Arthropathies\" class=\"cp-dx-node tier-amber cp-dxlink\">Gout</a><div class=\"cp-cdn\">▼</div><div class=\"cp-test\">polarised microscopy</div></div><div class=\"cp-col\"><div class=\"cp-feat\">Symmetrical small joints + morning stiffness</div><div class=\"cp-cdn\">▼</div><a href=\"#conditions/MSK%20%2F%20RHEUMATOLOGY/Rheumatoid%20Arthritis\" class=\"cp-dx-node tier-amber cp-dxlink\">Rheumatoid</a><div class=\"cp-cdn\">▼</div><div class=\"cp-test\">anti-CCP + USS</div></div><div class=\"cp-col\"><div class=\"cp-feat\">DIP + weight-bearing, worse with use</div><div class=\"cp-cdn\">▼</div><a href=\"#conditions/MSK%20%2F%20RHEUMATOLOGY/Osteoarthritis\" class=\"cp-dx-node tier-green cp-dxlink\">Osteoarthritis</a><div class=\"cp-cdn\">▼</div><div class=\"cp-test\">clinical + X-ray</div></div><div class=\"cp-col\"><div class=\"cp-feat\">Asymmetrical large joints / axial + psoriasis</div><div class=\"cp-cdn\">▼</div><a href=\"#conditions/MSK%20%2F%20RHEUMATOLOGY/Seronegative%20Spondyloarthropathies\" class=\"cp-dx-node tier-amber cp-dxlink\">Spondyloarthropathy</a><div class=\"cp-cdn\">▼</div><div class=\"cp-test\">MRI SIJ + HLA-B27</div></div></div></div><div class=\"cp-dn\">▼</div><div class=\"cp-node work\">Aspiration (Gram / culture / crystals) &middot; CRP / ESR, urate, RF / anti-CCP, ANA, HLA-B27 &middot; X-ray / ultrasound / MRI</div><div class=\"cp-dn\">▼</div><div class=\"cp-node final\">➡️ Open the condition note &mdash; Ix &middot; management &middot; prognosis</div></div></div></div></div>"}