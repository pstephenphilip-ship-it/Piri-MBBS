{"DERMATOLOGICAL__Rash": "<div class=\"cp\"><div class=\"cp\"><style>.cp *{box-sizing:border-box;}.cp{font-family:var(--sans,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif);color:var(--rn-text,#1E2640);line-height:1.5;}.cp-lead{font-size:14px;line-height:1.75;color:var(--rn-sub,#5A6480);margin:2px 0 14px;background:var(--rn-card,#fff);border:1.5px solid var(--rn-border,#E2E6F0);border-radius:12px;padding:16px 18px;box-shadow:0 1px 4px rgba(0,0,0,.05);}.cp-lead b{color:var(--rn-text,#1E2640);}.cp-warn{display:flex;gap:10px;background:var(--rn-red-bg,#FDEAEA);border:1.5px solid #F2BABA;color:var(--rn-text,#1E2640);border-radius:10px;padding:14px 18px;font-size:13.5px;line-height:1.7;margin-bottom:12px;}.cp-warn b{color:var(--rn-red,#C93535);}.cp-warn .cp-warn-ic{font-size:16px;line-height:1.4;}.cp-step{margin-bottom:12px;background:var(--rn-card,#fff);border:1.5px solid var(--rn-border,#E2E6F0);border-radius:12px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.05);}.cp-step-h{display:flex;align-items:center;gap:11px;padding:12px 20px;border-bottom:1.5px solid var(--rn-border,#E2E6F0);background:var(--rn-blue-bg,#EBF2FF);}.cp-step-body{padding:20px;}.cp-step-body>.cp-sub:first-child{margin-top:0;}.cp-num{flex:none;width:24px;height:24px;border-radius:50%;background:var(--rn-blue,#3B7DD8);color:#fff;font-size:13px;font-weight:800;display:flex;align-items:center;justify-content:center;font-family:var(--mono,'SF Mono',SFMono-Regular,ui-monospace,Menlo,Consolas,monospace);}.cp-title{font-family:var(--mono,'SF Mono',SFMono-Regular,ui-monospace,Menlo,Consolas,monospace);font-size:12px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--rn-blue,#3B7DD8);}.cp-killgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(215px,1fr));gap:11px;}.cp-kill{border:1px solid var(--rn-border,#E2E6F0);border-left:4px solid var(--kc,var(--rn-blue,#3B7DD8));border-radius:11px;padding:0;overflow:hidden;background:var(--rn-card,#fff);}.cp-kill-top{display:flex;align-items:center;gap:8px;padding:9px 13px;background:var(--kcb,var(--rn-blue-bg,#EBF2FF));border-bottom:1px solid var(--rn-border,#E2E6F0);}.cp-kill-ic{font-size:15px;}.cp-kill-name{font-size:14px;font-weight:800;color:var(--kc,var(--rn-text,#1E2640));}.cp-kill-desc{padding:11px 13px;font-size:12.5px;line-height:1.5;color:var(--rn-sub,#5A6480);}.cp-kill .cp-dx{margin-top:9px;}.cp-clue{display:flex;align-items:center;gap:12px;padding:11px 2px;border-bottom:1px solid var(--rn-border,#EEF1F7);}.cp-clue:last-child{border-bottom:none;}.cp-when{flex:1 1 44%;font-size:13.5px;font-weight:700;color:var(--rn-text,#1E2640);}.cp-arrow{flex:none;color:var(--rn-blue,#3B7DD8);font-weight:700;}.cp-then{flex:1 1 52%;display:flex;flex-wrap:wrap;gap:6px;}.cp-bed{padding:12px 14px;border-radius:10px;background:#F1F3F8;border:1.5px solid var(--rn-border,#E2E6F0);margin-bottom:8px;}.cp-bed-hot{background:var(--rn-red-bg,#FDEAEA);border-color:#F2BABA;}.cp-bed-h{display:flex;align-items:baseline;gap:8px;margin-bottom:7px;}.cp-bed-n{font-family:var(--mono,'SF Mono',SFMono-Regular,ui-monospace,Menlo,Consolas,monospace);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--rn-text,#1E2640);}.cp-bed-hot .cp-bed-n{color:var(--rn-red,#C93535);}.cp-bed-when{font-size:11px;color:var(--rn-muted,#9AA4B2);font-style:italic;}.cp-reads{display:flex;flex-wrap:wrap;gap:6px;}.cp-read{font-size:11.5px;line-height:1.35;background:var(--rn-card,#fff);border:1px solid var(--rn-border,#E2E6F0);border-radius:7px;padding:4px 9px;color:var(--rn-sub,#5A6480);}.cp-read b{color:var(--rn-text,#1E2640);font-weight:700;}.cp-read .cp-ar{color:var(--rn-blue,#3B7DD8);}.cp-bed-hot .cp-read{border-color:#F3B7B7;}.cp-sub{font-family:var(--mono,'SF Mono',SFMono-Regular,ui-monospace,Menlo,Consolas,monospace);font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--rn-text,#1E2640);margin:16px 0 10px;}.cp-confirm{display:flex;flex-wrap:wrap;gap:7px;}.cp-cfm{font-size:12px;line-height:1.4;background:var(--rn-blue-bg,#EBF2FF);border:1px solid #D6E4FA;border-radius:8px;padding:5px 10px;}.cp-cfm .cp-dxn{font-weight:800;color:var(--rn-text,#1E2640);}.cp-cfm .cp-ar{color:var(--rn-blue,#3B7DD8);}.cp-cfm .cp-tst{color:var(--rn-blue,#3B7DD8);font-weight:600;}.cp-pearl{background:var(--rn-yellow-bg,#FFFBE6);border:1.5px solid #E8D48A;border-left:4px solid var(--rn-yellow,#8A6C00);border-radius:0 10px 10px 0;padding:12px 16px;font-size:13.5px;line-height:1.6;color:var(--rn-text,#1E2640);margin-top:14px;}.cp-pearl b{color:var(--rn-text,#1E2640);}.cp-sysgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(255px,1fr));gap:11px;}.cp-sys{border:1px solid var(--rn-border,#E2E6F0);border-left:4px solid;border-radius:11px;padding:12px 14px;background:var(--rn-card,#fff);}.cp-sys.tier-red{border-left-color:var(--rn-red,#C93535);}.cp-sys.tier-amber{border-left-color:var(--rn-amber,#B86B00);}.cp-sys.tier-green{border-left-color:var(--rn-green,#1F8B5E);}.cp-sys-h{font-family:var(--mono,'SF Mono',SFMono-Regular,ui-monospace,Menlo,Consolas,monospace);font-size:11px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--rn-text,#1E2640);margin-bottom:9px;}.cp-sys-dx{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px;}.cp-sys-d{font-size:12px;line-height:1.45;color:var(--rn-sub,#5A6480);}.cp-dx{display:inline-block;font-size:12.5px;font-weight:600;text-decoration:none;padding:3px 10px;border-radius:999px;background:var(--rn-blue-bg,#EBF2FF);color:var(--rn-blue,#3B7DD8);border:1px solid transparent;transition:all .13s;}.cp-dx:hover{border-color:var(--rn-blue,#3B7DD8);}.cp-dx-off{background:#F1F3F8;color:var(--rn-sub,#7A8396);}.cp-hand{display:flex;gap:10px;background:var(--rn-blue-bg,#EBF2FF);border:1.5px solid #B0CCEF;border-radius:10px;padding:14px 18px;font-size:13.5px;line-height:1.7;color:var(--rn-text,#1E2640);margin-top:26px;}.cp-hand b{color:var(--rn-blue,#3B7DD8);}.cp-mapic{font-size:18px;line-height:1;}.cp-flow{display:flex;flex-direction:column;align-items:center;text-align:center;}.cp-dn{color:var(--rn-border,#C7CEDB);font-size:13px;line-height:1;margin:5px 0;}.cp-node{border-radius:11px;padding:10px 18px;font-weight:700;font-size:13.5px;max-width:560px;background:var(--rn-card,#fff);border:1.5px solid var(--rn-border,#E2E6F0);color:var(--rn-text,#1E2640);}.cp-node.start{background:var(--rn-blue-bg,#EBF2FF);border-color:#B0CCEF;color:var(--rn-blue,#3B7DD8);font-weight:800;letter-spacing:.06em;}.cp-node.danger{background:var(--rn-red-bg,#FDEAEA);border-color:#EDBFBF;color:var(--rn-red,#C93535);}.cp-node-sub{font-weight:500;font-size:10.5px;margin-top:3px;opacity:.9;}.cp-flowlabel{font-size:11px;color:var(--rn-muted,#9AA4B2);font-style:italic;margin:6px 0;}.cp-node.decision{background:var(--rn-amber-bg,#FEF5E4);border-color:#E8CE93;color:var(--rn-amber,#B86B00);}.cp-node.work{background:var(--rn-blue-bg,#EBF2FF);border-color:#B0CCEF;color:var(--rn-blue,#3B7DD8);font-weight:800;}.cp-node.final{background:var(--rn-blue-bg,#EBF2FF);border-color:#B7CEF0;color:var(--rn-blue,#3B7DD8);}.cp-branchbox{width:100%;border:1.5px dashed var(--rn-border,#D8DEEA);border-radius:14px;padding:14px 12px;background:transparent;}.cp-branchcols{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;}.cp-col{display:flex;flex-direction:column;align-items:center;flex:1 1 128px;max-width:150px;}.cp-feat{font-size:11px;font-weight:600;background:#F1F3F8;border:1px solid var(--rn-border,#E2E6F0);border-radius:8px;padding:6px 8px;width:100%;min-height:42px;display:flex;align-items:center;justify-content:center;color:var(--rn-sub,#5A6480);}.cp-cdn{color:var(--rn-border,#C7CEDB);font-size:10px;margin:3px 0;}.cp-dx-node{font-size:12px;font-weight:800;border-radius:8px;padding:7px 8px;width:100%;border:1px solid;text-decoration:none;}.cp-dx-node.tier-red{background:var(--rn-red-bg,#FDEAEA);border-color:#EDC6C6;color:var(--rn-red,#C93535);}.cp-dx-node.tier-amber{background:var(--rn-amber-bg,#FEF5E4);border-color:#EAD4A4;color:var(--rn-amber,#B86B00);}.cp-dx-node.tier-green{background:var(--rn-green-bg,#E6F6EF);border-color:#B9E2CD;color:var(--rn-green,#1F8B5E);}.cp-test{font-size:10.5px;color:var(--rn-sub,#7A8396);font-weight:600;margin-top:5px;}.cp-dxlink{display:block;text-decoration:none;cursor:pointer;}.cp-dxlink:hover{box-shadow:0 0 0 2px currentColor inset;}</style><div class=\"cp-lead\"><b>&ldquo;Rash&rdquo; is not a diagnosis &mdash; it is a starting point.</b> The first question is never &ldquo;what is it called?&rdquo; but <b>&ldquo;is the patient sick, and are there red flags?&rdquo;</b> Fever with a <b>non-blanching</b> rash is <b>meningococcal sepsis</b> until proven otherwise &rarr; antibiotics now (see <a class=\"cp-dx\" href=\"#conditions/INFECTIOUS%20DISEASE%20%26%20IMMUNOLOGY/Meningococcal%20Disease\">meningococcal disease</a>, <a class=\"cp-dx\" href=\"#signs/HAEMATOLOGICAL/Petechiae%20%26%20Purpura\">petechiae &amp; purpura</a>); a <b>painful rash with mucosal erosions and blistering</b> is <b>Stevens-Johnson / toxic epidermal necrolysis</b> &mdash; stop the drug (see <a class=\"cp-dx\" href=\"#conditions/DERMATOLOGY/Dermatological%20Emergencies\">dermatological emergencies</a>); <b>urticaria with airway or breathing compromise</b> is <b>anaphylaxis</b> &rarr; IM adrenaline (see <a class=\"cp-dx\" href=\"#conditions/RESPIRATORY/Anaphylaxis\">anaphylaxis</a>); and <b>&gt;90% erythema</b> is <b>erythroderma</b> (see <a class=\"cp-dx\" href=\"#signs/DERMATOLOGICAL/Erythroderma\">erythroderma</a>). Only once these are cleared do you <b>describe the morphology</b> (macular / papular, purpuric, vesicular / bullous, pustular, wheals, scaly plaques), the <b>distribution</b> and the <b>time course</b>, and route to the specific pattern &mdash; eczema, psoriasis, urticaria, a drug or viral exanthem (see <a class=\"cp-dx\" href=\"#conditions/DERMATOLOGY/Eczema%20%2F%20Atopic%20Dermatitis\">eczema</a>, <a class=\"cp-dx\" href=\"#conditions/DERMATOLOGY/Psoriasis\">psoriasis</a>). <b>SCAM</b>: Site, Configuration, Arrangement, Morphology.</div><div class=\"cp-warn\"><span class=\"cp-warn-ic\">🚨</span><span><b>Some rashes are emergencies.</b> Look for the warning signs: a <b>non-blanching purpuric</b> rash with fever (<b>meningococcal sepsis</b> &rarr; benzylpenicillin now) (see <a class=\"cp-dx\" href=\"#conditions/INFECTIOUS%20DISEASE%20%26%20IMMUNOLOGY/Meningococcal%20Disease\">meningococcal disease</a>); <b>skin pain / tenderness, mucosal involvement (mouth, eyes, genitals), blistering, skin detachment and a positive Nikolsky sign</b> (<b>SJS / TEN</b>, or DRESS with fever, facial oedema and eosinophilia) &mdash; <b>stop the culprit drug</b> (see <a class=\"cp-dx\" href=\"#conditions/DERMATOLOGY/Dermatological%20Emergencies\">dermatological emergencies</a>, <a class=\"cp-dx\" href=\"#signs/DERMATOLOGICAL/Blistering%20Rash\">blistering rash</a>); <b>urticaria with lip / tongue swelling, wheeze, stridor or hypotension</b> (<b>anaphylaxis</b>) (see <a class=\"cp-dx\" href=\"#conditions/RESPIRATORY/Anaphylaxis\">anaphylaxis</a>); <b>widespread erythema &gt;90%</b> with systemic upset (<b>erythroderma</b>); and <b>rapidly spreading erythema with pain out of proportion</b> (<b>necrotising fasciitis</b>) or <b>monomorphic punched-out erosions</b> on eczema (<b>eczema herpeticum</b>) (see <a class=\"cp-dx\" href=\"#conditions/DERMATOLOGY/Skin%20Infections\">skin infections</a>).</span></div><div style=\"font-size:22px;\"><div style=\"font-size:22px;\">📷</div><div style=\"font-size:12.5px;font-weight:700;\">Image placeholder &mdash; the rash: first ask is the patient UNWELL / red flags? (non-blanching + fever = meningococcal; mucosal + blistering = SJS/TEN; urticaria + airway = anaphylaxis; &gt;90% erythema = erythroderma). Then describe morphology (macular / papular, purpuric, vesicular / bullous, pustular, wheals, scaly), distribution &amp; time course</div><div style=\"font-family:var(--mono);font-size:10.5px;text-transform:uppercase;letter-spacing:.05em;color:var(--rn-muted,#9AA4B2);margin-top:10px;\">link to be uploaded</div></div><div class=\"cp-step\" id=\"s-1\"><div class=\"cp-step-h\"><span class=\"cp-num\">1</span><span class=\"cp-title\">Confirm &amp; classify</span></div><div class=\"cp-step-body\"><div class=\"cp-killgrid\"><div class=\"cp-kill\" style=\"--kc:var(--rn-red,#C93535);--kcb:var(--rn-red-bg,#FDEAEA);\"><div class=\"cp-kill-top\"><span class=\"cp-kill-ic\">🚩</span><span class=\"cp-kill-name\">Meningococcal sepsis</span></div><div class=\"cp-kill-desc\"><ul style=\"margin:6px 0 0;padding-left:17px;list-style:disc;\"><li style=\"margin:3px 0;\"><b>Fever + a non-blanching purpuric / petechial rash</b> + systemically unwell</li><li style=\"margin:3px 0;\">&rarr; <b>immediate antibiotics</b> (benzylpenicillin / ceftriaxone) + resuscitation, do not wait (see <a class=\"cp-dx\" href=\"#conditions/INFECTIOUS%20DISEASE%20%26%20IMMUNOLOGY/Meningococcal%20Disease\">meningococcal disease</a>, <a class=\"cp-dx\" href=\"#signs/HAEMATOLOGICAL/Petechiae%20%26%20Purpura\">petechiae &amp; purpura</a>)</li><li style=\"margin:3px 0;\">Glass (tumbler) test; may have meningism, shock</li></ul></div></div><div class=\"cp-kill\" style=\"--kc:var(--rn-red,#C93535);--kcb:var(--rn-red-bg,#FDEAEA);\"><div class=\"cp-kill-top\"><span class=\"cp-kill-ic\">🚩</span><span class=\"cp-kill-name\">SJS / TEN &amp; drug emergencies</span></div><div class=\"cp-kill-desc\"><ul style=\"margin:6px 0 0;padding-left:17px;list-style:disc;\"><li style=\"margin:3px 0;\"><b>Painful rash + mucosal erosions</b> (mouth, eyes, genitals) + blisters + <b>skin detachment</b> (Nikolsky+)</li><li style=\"margin:3px 0;\">A drug trigger 1&ndash;3 weeks before &mdash; <b>stop the culprit</b>, dermatological emergency (see <a class=\"cp-dx\" href=\"#conditions/DERMATOLOGY/Dermatological%20Emergencies\">dermatological emergencies</a>, <a class=\"cp-dx\" href=\"#signs/DERMATOLOGICAL/Blistering%20Rash\">blistering rash</a>)</li><li style=\"margin:3px 0;\"><b>DRESS</b>: fever, facial oedema, eosinophilia, organ involvement</li></ul></div></div><div class=\"cp-kill\" style=\"--kc:var(--rn-red,#C93535);--kcb:var(--rn-red-bg,#FDEAEA);\"><div class=\"cp-kill-top\"><span class=\"cp-kill-ic\">🚩</span><span class=\"cp-kill-name\">Anaphylaxis / angioedema</span></div><div class=\"cp-kill-desc\"><ul style=\"margin:6px 0 0;padding-left:17px;list-style:disc;\"><li style=\"margin:3px 0;\"><b>Urticaria</b> + <b>lip / tongue swelling</b>, wheeze, stridor, hypotension</li><li style=\"margin:3px 0;\">&rarr; <b>IM adrenaline</b>, ABC, remove trigger (see <a class=\"cp-dx\" href=\"#conditions/RESPIRATORY/Anaphylaxis\">anaphylaxis</a>, <a class=\"cp-dx\" href=\"#conditions/DERMATOLOGY/Urticaria%20%2F%20Angioedema\">urticaria</a>)</li><li style=\"margin:3px 0;\">Rapid onset after food / drug / sting</li></ul></div></div><div class=\"cp-kill\" style=\"--kc:var(--rn-amber,#B86B00);--kcb:var(--rn-amber-bg,#FEF5E4);\"><div class=\"cp-kill-top\"><span class=\"cp-kill-ic\">🟠</span><span class=\"cp-kill-name\">Erythroderma</span></div><div class=\"cp-kill-desc\"><ul style=\"margin:6px 0 0;padding-left:17px;list-style:disc;\"><li style=\"margin:3px 0;\"><b>&gt;90% of the skin red and scaly</b> + systemic upset</li><li style=\"margin:3px 0;\">Fluid / heat / protein loss, high-output failure, sepsis risk (see <a class=\"cp-dx\" href=\"#signs/DERMATOLOGICAL/Erythroderma\">erythroderma</a>)</li><li style=\"margin:3px 0;\">Causes: eczema, psoriasis, drugs, lymphoma (S&eacute;zary)</li></ul></div></div><div class=\"cp-kill\" style=\"--kc:var(--rn-amber,#B86B00);--kcb:var(--rn-amber-bg,#FEF5E4);\"><div class=\"cp-kill-top\"><span class=\"cp-kill-ic\">🟠</span><span class=\"cp-kill-name\">Serious skin infection</span></div><div class=\"cp-kill-desc\"><ul style=\"margin:6px 0 0;padding-left:17px;list-style:disc;\"><li style=\"margin:3px 0;\"><b>Cellulitis</b> (hot, spreading, tender erythema + fever) (see <a class=\"cp-dx\" href=\"#conditions/DERMATOLOGY/Cellulitis\">cellulitis</a>)</li><li style=\"margin:3px 0;\"><b>Necrotising fasciitis</b> (pain out of proportion, crepitus, rapid) &mdash; surgical emergency</li><li style=\"margin:3px 0;\"><b>Eczema herpeticum</b> (monomorphic punched-out erosions), staph scalded skin (see <a class=\"cp-dx\" href=\"#conditions/DERMATOLOGY/Skin%20Infections\">skin infections</a>)</li></ul></div></div><div class=\"cp-kill\" style=\"--kc:var(--rn-blue,#3B7DD8);--kcb:var(--rn-blue-bg,#EBF2FF);\"><div class=\"cp-kill-top\"><span class=\"cp-kill-ic\">🩹</span><span class=\"cp-kill-name\">Common inflammatory dermatoses</span></div><div class=\"cp-kill-desc\"><ul style=\"margin:6px 0 0;padding-left:17px;list-style:disc;\"><li style=\"margin:3px 0;\"><b>Eczema</b> (itchy, flexural), <b>psoriasis</b> (scaly extensor plaques) (see <a class=\"cp-dx\" href=\"#conditions/DERMATOLOGY/Eczema%20%2F%20Atopic%20Dermatitis\">eczema</a>, <a class=\"cp-dx\" href=\"#conditions/DERMATOLOGY/Psoriasis\">psoriasis</a>)</li><li style=\"margin:3px 0;\"><b>Urticaria</b> (transient wheals), <b>contact dermatitis</b> (see <a class=\"cp-dx\" href=\"#conditions/DERMATOLOGY/Contact%20%26%20Seborrhoeic%20Dermatitis\">contact dermatitis</a>)</li><li style=\"margin:3px 0;\">Viral exanthem, pityriasis rosea, lichen planus</li></ul></div></div></div><div class=\"cp-pearl\"><b>Sick or not sick, first.</b> Before naming a rash, screen for the emergencies: <b>non-blanching + fever</b>, <b>mucosae + blisters + skin pain</b>, <b>urticaria + airway</b>, <b>&gt;90% erythema</b>. Everything else is described by <b>morphology, distribution and time course</b>.</div></div></div><div class=\"cp-step\" id=\"s-2\"><div class=\"cp-step-h\"><span class=\"cp-num\">2</span><span class=\"cp-title\">What it points to</span></div><div class=\"cp-step-body\"><div class=\"cp-clues\"><div class=\"cp-clue\"><div class=\"cp-when\"><b>Fever + spreading non-blanching purpuric rash + unwell</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/INFECTIOUS%20DISEASE%20%26%20IMMUNOLOGY/Meningococcal%20Disease\">Meningococcal sepsis (antibiotics now)</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Painful rash + mucosal erosions + blisters + skin detachment (drug)</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/DERMATOLOGY/Dermatological%20Emergencies\">SJS / TEN</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Urticarial wheals + lip / tongue swelling + wheeze / hypotension</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/RESPIRATORY/Anaphylaxis\">Anaphylaxis</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Widespread erythema + scaling over &gt;90% + systemic upset</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#signs/DERMATOLOGICAL/Erythroderma\">Erythroderma</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Chronic, itchy, flexural rash in an atopic patient</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/DERMATOLOGY/Eczema%20%2F%20Atopic%20Dermatitis\">Eczema / atopic dermatitis</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Well-demarcated salmon plaques + silvery scale on extensors / scalp</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/DERMATOLOGY/Psoriasis\">Psoriasis</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Transient itchy wheals, each lasting &lt;24&nbsp;hours, migrating</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/DERMATOLOGY/Urticaria%20%2F%20Angioedema\">Urticaria</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Child + fever + widespread maculopapular / vesicular rash</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/PAEDIATRICS/Childhood%20Exanthems%20%28Rashes%29\">Childhood exanthem</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Hot, tender, spreading erythema of one limb + fever</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/DERMATOLOGY/Cellulitis\">Cellulitis</a></div></div></div><div class=\"cp-pearl\"><b>Describe before you diagnose.</b> The <b>morphology</b> (macule, papule, vesicle, pustule, wheal, plaque, purpura), <b>distribution</b> (flexural, extensor, photodistributed, dermatomal) and <b>time course</b> narrow the list faster than any single &ldquo;spot diagnosis&rdquo;.</div></div></div><div class=\"cp-step\" id=\"s-3\"><div class=\"cp-step-h\"><span class=\"cp-num\">3</span><span class=\"cp-title\">Assess &amp; act</span></div><div class=\"cp-step-body\"><div class=\"cp-sub\">At the bedside &mdash; sick or not, blanching or not, the morphology and distribution</div><div class=\"cp-bed\"><div class=\"cp-bed-h\"><span class=\"cp-bed-n\">History &amp; red flags</span></div><div class=\"cp-reads\"><span class=\"cp-read\"><b>Onset and speed</b>, <b>fever / systemic upset</b>, <b>itch or pain</b>; <b>new drugs</b> (1&ndash;3 weeks), infections, contacts, travel, atopy; <b>mucosal, airway or joint symptoms</b>; sun exposure; what makes it better / worse</span></div></div><div class=\"cp-bed cp-bed-hot\"><div class=\"cp-bed-h\"><span class=\"cp-bed-n\">Examine</span></div><div class=\"cp-reads\"><span class=\"cp-read\"><b>Blanching?</b> (glass test), <b>morphology</b> (macule / papule / vesicle / pustule / wheal / plaque / purpura), <b>distribution &amp; configuration</b>; check <b>mucosae, nails, scalp, palms / soles</b>; <b>Nikolsky sign</b>; are they <b>febrile / unwell</b>, any airway compromise?</span></div></div><div class=\"cp-bed\"><div class=\"cp-bed-h\"><span class=\"cp-bed-n\">Investigate</span></div><div class=\"cp-reads\"><span class=\"cp-read\">Often <b>clinical</b>; for the unwell: <b>FBC, CRP, U&amp;E, LFTs, cultures / meningococcal PCR, eosinophils</b> (DRESS); <b>skin swab / viral PCR</b>, <b>skin biopsy</b> for a blistering / uncertain rash, <b>mast-cell tryptase</b> after anaphylaxis, and targeted autoimmune / infection screens</span></div></div><div class=\"cp-bed\"><div class=\"cp-bed-h\"><span class=\"cp-bed-n\">Act</span></div><div class=\"cp-reads\"><span class=\"cp-read\"><b>Treat the emergency first</b> &mdash; antibiotics for meningococcal sepsis, IM adrenaline for anaphylaxis, stop the drug and refer SJS / TEN, supportive care for erythroderma; then treat the pattern &mdash; emollients / topical steroids for eczema, antihistamines for urticaria, antibiotics for cellulitis, and refer where the diagnosis is unclear</span></div></div><div class=\"cp-sub\">Then &mdash; confirm the cause</div><div class=\"cp-confirm\"><span class=\"cp-cfm\"><span class=\"cp-dxn\">Meningococcal sepsis</span> <span class=\"cp-ar\">&rarr;</span> <span class=\"cp-tst\"><b>clinical &rarr; antibiotics</b> (cultures / PCR)</span></span><span class=\"cp-cfm\"><span class=\"cp-dxn\">SJS / TEN</span> <span class=\"cp-ar\">&rarr;</span> <span class=\"cp-tst\"><b>clinical + skin biopsy</b>; stop drug</span></span><span class=\"cp-cfm\"><span class=\"cp-dxn\">Anaphylaxis</span> <span class=\"cp-ar\">&rarr;</span> <span class=\"cp-tst\"><b>clinical &rarr; adrenaline</b> (tryptase)</span></span><span class=\"cp-cfm\"><span class=\"cp-dxn\">Erythroderma</span> <span class=\"cp-ar\">&rarr;</span> <span class=\"cp-tst\"><b>clinical + find the cause</b></span></span><span class=\"cp-cfm\"><span class=\"cp-dxn\">Eczema / psoriasis</span> <span class=\"cp-ar\">&rarr;</span> <span class=\"cp-tst\"><b>clinical</b> (&plusmn; biopsy)</span></span><span class=\"cp-cfm\"><span class=\"cp-dxn\">Cellulitis</span> <span class=\"cp-ar\">&rarr;</span> <span class=\"cp-tst\"><b>clinical</b> (bloods / cultures)</span></span></div><div class=\"cp-pearl\"><b>The rules that carry it:</b> screen for the <b>four emergencies</b> (non-blanching + fever; mucosae + blisters; urticaria + airway; &gt;90% erythema) <b>before</b> anything else. Then <b>describe</b> the rash &mdash; morphology, distribution, time course &mdash; and route to the pattern.</div></div></div><div class=\"cp-hand\" id=\"s-hand\"><span>➡️</span><span>Landed on a diagnosis? Open its <b>note</b> for investigations, management &amp; prognosis &mdash; every blue link above jumps straight there. <b>This is where the conditions library takes over.</b></span></div><div class=\"cp-step\" id=\"s-map\"><div class=\"cp-step-h\"><span class=\"cp-mapic\">🗺️</span><span class=\"cp-title\">In summary</span></div><div class=\"cp-step-body\"><div class=\"cp-flow\"><div class=\"cp-node start\">RASH &mdash; first ask: is the patient SICK / any RED FLAGS? (not &ldquo;what is it called?&rdquo;)</div><div class=\"cp-dn\">▼</div><div class=\"cp-node danger\">Non-blanching + fever = meningococcal &rarr; antibiotics NOW &middot; mucosae + blisters + skin pain = SJS / TEN (stop drug) &middot; urticaria + airway = anaphylaxis (adrenaline) &middot; &gt;90% erythema = erythroderma</div><div class=\"cp-dn\">▼</div><div class=\"cp-node decision\">Not an emergency &rarr; describe the MORPHOLOGY: macular / papular &middot; purpuric &middot; vesicular / bullous &middot; pustular &middot; wheals &middot; scaly plaques</div><div class=\"cp-dn\">▼</div><div class=\"cp-node decision\">Add DISTRIBUTION (flexural / extensor / photo / dermatomal) + TIME COURSE (acute vs chronic, transient vs fixed) + itch / pain</div><div class=\"cp-dn\">▼</div><div class=\"cp-branchbox\"><div class=\"cp-branchcols\"><div class=\"cp-col\"><div class=\"cp-feat\">Fever + non-blanching purpura</div><div class=\"cp-cdn\">▼</div><a href=\"#conditions/INFECTIOUS%20DISEASE%20%26%20IMMUNOLOGY/Meningococcal%20Disease\" class=\"cp-dx-node tier-red cp-dxlink\">Meningococcal sepsis</a><div class=\"cp-cdn\">▼</div><div class=\"cp-test\">antibiotics now</div></div><div class=\"cp-col\"><div class=\"cp-feat\">Mucosal erosions + blisters + drug</div><div class=\"cp-cdn\">▼</div><a href=\"#conditions/DERMATOLOGY/Dermatological%20Emergencies\" class=\"cp-dx-node tier-red cp-dxlink\">SJS / TEN</a><div class=\"cp-cdn\">▼</div><div class=\"cp-test\">stop drug + biopsy</div></div><div class=\"cp-col\"><div class=\"cp-feat\">Urticaria + airway / breathing compromise</div><div class=\"cp-cdn\">▼</div><a href=\"#conditions/RESPIRATORY/Anaphylaxis\" class=\"cp-dx-node tier-red cp-dxlink\">Anaphylaxis</a><div class=\"cp-cdn\">▼</div><div class=\"cp-test\">IM adrenaline</div></div><div class=\"cp-col\"><div class=\"cp-feat\">&gt;90% erythema + systemic upset</div><div class=\"cp-cdn\">▼</div><a href=\"#signs/DERMATOLOGICAL/Erythroderma\" class=\"cp-dx-node tier-amber cp-dxlink\">Erythroderma</a><div class=\"cp-cdn\">▼</div><div class=\"cp-test\">supportive + cause</div></div><div class=\"cp-col\"><div class=\"cp-feat\">Itchy, chronic, flexural</div><div class=\"cp-cdn\">▼</div><a href=\"#conditions/DERMATOLOGY/Eczema%20%2F%20Atopic%20Dermatitis\" class=\"cp-dx-node tier-green cp-dxlink\">Eczema / common dermatoses</a><div class=\"cp-cdn\">▼</div><div class=\"cp-test\">clinical</div></div></div></div><div class=\"cp-dn\">▼</div><div class=\"cp-node work\">Often clinical &middot; for the unwell: FBC / CRP / U&amp;E / LFTs / cultures / PCR / eosinophils &middot; skin swab / viral PCR &middot; skin biopsy for blistering / uncertain &middot; tryptase after anaphylaxis</div><div class=\"cp-dn\">▼</div><div class=\"cp-node final\">➡️ Open the condition note &mdash; treat the emergency first (antibiotics / adrenaline / stop the drug / supportive), then treat the pattern (emollients + steroids, antihistamines, antibiotics)</div></div></div></div></div>"}