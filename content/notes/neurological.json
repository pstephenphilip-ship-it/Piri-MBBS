{"NEUROLOGICAL__Headache": "<div class=\"cp\"><div class=\"cp\"><style>.cp *{box-sizing:border-box;}.cp{font-family:var(--sans,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif);color:var(--rn-text,#1E2640);line-height:1.5;}.cp-lead{font-size:14px;line-height:1.75;color:var(--rn-sub,#5A6480);margin:2px 0 14px;background:var(--rn-card,#fff);border:1.5px solid var(--rn-border,#E2E6F0);border-radius:12px;padding:16px 18px;box-shadow:0 1px 4px rgba(0,0,0,.05);}.cp-lead b{color:var(--rn-text,#1E2640);}.cp-warn{display:flex;gap:10px;background:var(--rn-red-bg,#FDEAEA);border:1.5px solid #F2BABA;color:var(--rn-text,#1E2640);border-radius:10px;padding:14px 18px;font-size:13.5px;line-height:1.7;margin-bottom:12px;}.cp-warn b{color:var(--rn-red,#C93535);}.cp-warn .cp-warn-ic{font-size:16px;line-height:1.4;}.cp-step{margin-bottom:12px;background:var(--rn-card,#fff);border:1.5px solid var(--rn-border,#E2E6F0);border-radius:12px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.05);}.cp-step-h{display:flex;align-items:center;gap:11px;padding:12px 20px;border-bottom:1.5px solid var(--rn-border,#E2E6F0);background:var(--rn-blue-bg,#EBF2FF);}.cp-step-body{padding:20px;}.cp-step-body>.cp-sub:first-child{margin-top:0;}.cp-num{flex:none;width:24px;height:24px;border-radius:50%;background:var(--rn-blue,#3B7DD8);color:#fff;font-size:13px;font-weight:800;display:flex;align-items:center;justify-content:center;font-family:var(--mono,'SF Mono',SFMono-Regular,ui-monospace,Menlo,Consolas,monospace);}.cp-title{font-family:var(--mono,'SF Mono',SFMono-Regular,ui-monospace,Menlo,Consolas,monospace);font-size:12px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--rn-blue,#3B7DD8);}.cp-killgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(215px,1fr));gap:11px;}.cp-kill{border:1px solid var(--rn-border,#E2E6F0);border-left:4px solid var(--kc,var(--rn-blue,#3B7DD8));border-radius:11px;padding:0;overflow:hidden;background:var(--rn-card,#fff);}.cp-kill-top{display:flex;align-items:center;gap:8px;padding:9px 13px;background:var(--kcb,var(--rn-blue-bg,#EBF2FF));border-bottom:1px solid var(--rn-border,#E2E6F0);}.cp-kill-ic{font-size:15px;}.cp-kill-name{font-size:14px;font-weight:800;color:var(--kc,var(--rn-text,#1E2640));}.cp-kill-desc{padding:11px 13px;font-size:12.5px;line-height:1.5;color:var(--rn-sub,#5A6480);}.cp-kill .cp-dx{margin-top:9px;}.cp-clue{display:flex;align-items:center;gap:12px;padding:11px 2px;border-bottom:1px solid var(--rn-border,#EEF1F7);}.cp-clue:last-child{border-bottom:none;}.cp-when{flex:1 1 44%;font-size:13.5px;font-weight:700;color:var(--rn-text,#1E2640);}.cp-arrow{flex:none;color:var(--rn-blue,#3B7DD8);font-weight:700;}.cp-then{flex:1 1 52%;display:flex;flex-wrap:wrap;gap:6px;}.cp-bed{padding:12px 14px;border-radius:10px;background:#F1F3F8;border:1.5px solid var(--rn-border,#E2E6F0);margin-bottom:8px;}.cp-bed-hot{background:var(--rn-red-bg,#FDEAEA);border-color:#F2BABA;}.cp-bed-h{display:flex;align-items:baseline;gap:8px;margin-bottom:7px;}.cp-bed-n{font-family:var(--mono,'SF Mono',SFMono-Regular,ui-monospace,Menlo,Consolas,monospace);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--rn-text,#1E2640);}.cp-bed-hot .cp-bed-n{color:var(--rn-red,#C93535);}.cp-bed-when{font-size:11px;color:var(--rn-muted,#9AA4B2);font-style:italic;}.cp-reads{display:flex;flex-wrap:wrap;gap:6px;}.cp-read{font-size:11.5px;line-height:1.35;background:var(--rn-card,#fff);border:1px solid var(--rn-border,#E2E6F0);border-radius:7px;padding:4px 9px;color:var(--rn-sub,#5A6480);}.cp-read b{color:var(--rn-text,#1E2640);font-weight:700;}.cp-read .cp-ar{color:var(--rn-blue,#3B7DD8);}.cp-bed-hot .cp-read{border-color:#F3B7B7;}.cp-sub{font-family:var(--mono,'SF Mono',SFMono-Regular,ui-monospace,Menlo,Consolas,monospace);font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--rn-text,#1E2640);margin:16px 0 10px;}.cp-confirm{display:flex;flex-wrap:wrap;gap:7px;}.cp-cfm{font-size:12px;line-height:1.4;background:var(--rn-blue-bg,#EBF2FF);border:1px solid #D6E4FA;border-radius:8px;padding:5px 10px;}.cp-cfm .cp-dxn{font-weight:800;color:var(--rn-text,#1E2640);}.cp-cfm .cp-ar{color:var(--rn-blue,#3B7DD8);}.cp-cfm .cp-tst{color:var(--rn-blue,#3B7DD8);font-weight:600;}.cp-pearl{background:var(--rn-yellow-bg,#FFFBE6);border:1.5px solid #E8D48A;border-left:4px solid var(--rn-yellow,#8A6C00);border-radius:0 10px 10px 0;padding:12px 16px;font-size:13.5px;line-height:1.6;color:var(--rn-text,#1E2640);margin-top:14px;}.cp-pearl b{color:var(--rn-text,#1E2640);}.cp-sysgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(255px,1fr));gap:11px;}.cp-sys{border:1px solid var(--rn-border,#E2E6F0);border-left:4px solid;border-radius:11px;padding:12px 14px;background:var(--rn-card,#fff);}.cp-sys.tier-red{border-left-color:var(--rn-red,#C93535);}.cp-sys.tier-amber{border-left-color:var(--rn-amber,#B86B00);}.cp-sys.tier-green{border-left-color:var(--rn-green,#1F8B5E);}.cp-sys-h{font-family:var(--mono,'SF Mono',SFMono-Regular,ui-monospace,Menlo,Consolas,monospace);font-size:11px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--rn-text,#1E2640);margin-bottom:9px;}.cp-sys-dx{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px;}.cp-sys-d{font-size:12px;line-height:1.45;color:var(--rn-sub,#5A6480);}.cp-dx{display:inline-block;font-size:12.5px;font-weight:600;text-decoration:none;padding:3px 10px;border-radius:999px;background:var(--rn-blue-bg,#EBF2FF);color:var(--rn-blue,#3B7DD8);border:1px solid transparent;transition:all .13s;}.cp-dx:hover{border-color:var(--rn-blue,#3B7DD8);}.cp-dx-off{background:#F1F3F8;color:var(--rn-sub,#7A8396);}.cp-hand{display:flex;gap:10px;background:var(--rn-blue-bg,#EBF2FF);border:1.5px solid #B0CCEF;border-radius:10px;padding:14px 18px;font-size:13.5px;line-height:1.7;color:var(--rn-text,#1E2640);margin-top:26px;}.cp-hand b{color:var(--rn-blue,#3B7DD8);}.cp-mapic{font-size:18px;line-height:1;}.cp-flow{display:flex;flex-direction:column;align-items:center;text-align:center;}.cp-dn{color:var(--rn-border,#C7CEDB);font-size:13px;line-height:1;margin:5px 0;}.cp-node{border-radius:11px;padding:10px 18px;font-weight:700;font-size:13.5px;max-width:560px;background:var(--rn-card,#fff);border:1.5px solid var(--rn-border,#E2E6F0);color:var(--rn-text,#1E2640);}.cp-node.start{background:var(--rn-blue-bg,#EBF2FF);border-color:#B0CCEF;color:var(--rn-blue,#3B7DD8);font-weight:800;letter-spacing:.06em;}.cp-node.danger{background:var(--rn-red-bg,#FDEAEA);border-color:#EDBFBF;color:var(--rn-red,#C93535);}.cp-node-sub{font-weight:500;font-size:10.5px;margin-top:3px;opacity:.9;}.cp-flowlabel{font-size:11px;color:var(--rn-muted,#9AA4B2);font-style:italic;margin:6px 0;}.cp-node.decision{background:var(--rn-amber-bg,#FEF5E4);border-color:#E8CE93;color:var(--rn-amber,#B86B00);}.cp-node.work{background:var(--rn-blue-bg,#EBF2FF);border-color:#B0CCEF;color:var(--rn-blue,#3B7DD8);font-weight:800;}.cp-node.final{background:var(--rn-blue-bg,#EBF2FF);border-color:#B7CEF0;color:var(--rn-blue,#3B7DD8);}.cp-branchbox{width:100%;border:1.5px dashed var(--rn-border,#D8DEEA);border-radius:14px;padding:14px 12px;background:transparent;}.cp-branchcols{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;}.cp-col{display:flex;flex-direction:column;align-items:center;flex:1 1 128px;max-width:150px;}.cp-feat{font-size:11px;font-weight:600;background:#F1F3F8;border:1px solid var(--rn-border,#E2E6F0);border-radius:8px;padding:6px 8px;width:100%;min-height:42px;display:flex;align-items:center;justify-content:center;color:var(--rn-sub,#5A6480);}.cp-cdn{color:var(--rn-border,#C7CEDB);font-size:10px;margin:3px 0;}.cp-dx-node{font-size:12px;font-weight:800;border-radius:8px;padding:7px 8px;width:100%;border:1px solid;text-decoration:none;}.cp-dx-node.tier-red{background:var(--rn-red-bg,#FDEAEA);border-color:#EDC6C6;color:var(--rn-red,#C93535);}.cp-dx-node.tier-amber{background:var(--rn-amber-bg,#FEF5E4);border-color:#EAD4A4;color:var(--rn-amber,#B86B00);}.cp-dx-node.tier-green{background:var(--rn-green-bg,#E6F6EF);border-color:#B9E2CD;color:var(--rn-green,#1F8B5E);}.cp-test{font-size:10.5px;color:var(--rn-sub,#7A8396);font-weight:600;margin-top:5px;}.cp-dxlink{display:block;text-decoration:none;cursor:pointer;}.cp-dxlink:hover{box-shadow:0 0 0 2px currentColor inset;}</style><div class=\"cp-lead\"><b>Headache</b> is common and usually benign, but the job is to <b>screen out the dangerous secondary causes</b> before pattern-matching a <b>primary</b> headache. Take a focused history &mdash; <b>onset</b> (sudden vs gradual), <b>time course</b>, <b>triggers/relievers</b>, <b>associated features</b> and <b>age</b> &mdash; and run the <b>red flags</b>. A <b>thunderclap</b> onset, <b>fever with neck stiffness</b>, a <b>new headache over 50 with scalp tenderness</b>, or a <b>progressive headache with focal signs or papilloedema</b> each point to a serious cause. If the red flags are clear, sort the primary type: <b>migraine, tension-type or cluster</b>.</div><div class=\"cp-warn\"><span class=\"cp-warn-ic\">🚨</span><span><b>Thunderclap</b> (peaks &lt;5&nbsp;min) &rarr; <b>subarachnoid haemorrhage</b> until proven otherwise &mdash; CT then LP (see <a class=\"cp-dx\" href=\"#conditions/NEUROLOGY%20%2F%20NEUROSURGERY/Intracranial%20Haemorrhages\">intracranial haemorrhage</a>). <b>Fever + neck stiffness + photophobia</b> &rarr; <b>meningitis / encephalitis</b> (see <a class=\"cp-dx\" href=\"#conditions/NEUROLOGY%20%2F%20NEUROSURGERY/Meningitis%20%2F%20Encephalitis\">meningitis</a>, <a class=\"cp-dx\" href=\"#signs/NEUROLOGICAL/Meningism (Neck Stiffness, Kernig's / Brudzinski's)\">meningism</a>). <b>New headache &gt;50 with scalp tenderness / jaw claudication</b> &rarr; <b>giant cell arteritis</b> &mdash; high-dose steroids now to save sight (see <a class=\"cp-dx\" href=\"#conditions/MSK%20%2F%20RHEUMATOLOGY/Vasculitis\">GCA / vasculitis</a>). <b>Progressive, worse on waking / lying / coughing, with vomiting, focal signs or papilloedema</b> &rarr; <b>raised ICP / space-occupying lesion</b> (see <a class=\"cp-dx\" href=\"#conditions/NEUROLOGY%20%2F%20NEUROSURGERY/Raised%20Intracranial%20Pressure\">raised ICP</a>, <a class=\"cp-dx\" href=\"#conditions/NEUROLOGY%20%2F%20NEUROSURGERY/Brain%20Tumours\">brain tumour</a>).</span></div><div style=\"font-size:22px;\"><div style=\"font-size:22px;\">📷</div><div style=\"font-size:12.5px;font-weight:700;\">Image placeholder &mdash; the red-flag headache features (thunderclap, meningism, GCA scalp / temporal artery, papilloedema of raised ICP) and the primary-headache patterns (unilateral throbbing migraine, band-like tension-type, cluster with autonomic features)</div><div style=\"font-family:var(--mono);font-size:10.5px;text-transform:uppercase;letter-spacing:.05em;color:var(--rn-muted,#9AA4B2);margin-top:10px;\">link to be uploaded</div></div><div class=\"cp-step\" id=\"s-1\"><div class=\"cp-step-h\"><span class=\"cp-num\">1</span><span class=\"cp-title\">Recognise &amp; classify</span></div><div class=\"cp-step-body\"><div class=\"cp-killgrid\"><div class=\"cp-kill\" style=\"--kc:var(--rn-blue,#3B7DD8);--kcb:var(--rn-blue-bg,#EBF2FF);\"><div class=\"cp-kill-top\"><span class=\"cp-kill-ic\">🔍</span><span class=\"cp-kill-name\">Take the history &amp; split it</span></div><div class=\"cp-kill-desc\"><ul style=\"margin:6px 0 0;padding-left:17px;list-style:disc;\"><li style=\"margin:3px 0;\"><b>Onset</b>: <b>sudden / thunderclap</b> (vascular) vs <b>gradual</b>; <b>time course</b>: acute, episodic, chronic or progressive</li><li style=\"margin:3px 0;\"><b>Associated features</b>: aura, autonomic signs, fever, focal deficit, visual symptoms; and <b>age</b> (new headache &gt;50 is a red flag)</li><li style=\"margin:3px 0;\">First exclude a <b>secondary (dangerous)</b> cause, then match the <b>primary</b> type (migraine / tension / cluster)</li></ul></div></div><div class=\"cp-kill\" style=\"--kc:var(--rn-red,#C93535);--kcb:var(--rn-red-bg,#FDEAEA);\"><div class=\"cp-kill-top\"><span class=\"cp-kill-ic\">🚩</span><span class=\"cp-kill-name\">Red flags &mdash; secondary causes</span></div><div class=\"cp-kill-desc\"><ul style=\"margin:6px 0 0;padding-left:17px;list-style:disc;\"><li style=\"margin:3px 0;\"><b>Thunderclap</b> &rarr; <b>SAH</b> (also <a class=\"cp-dx\" href=\"#conditions/NEUROLOGY%20%2F%20NEUROSURGERY/Cerebral%20Venous%20Sinus%20Thrombosis\">CVST</a>, dissection, pituitary apoplexy) &mdash; see <a class=\"cp-dx\" href=\"#conditions/NEUROLOGY%20%2F%20NEUROSURGERY/Intracranial%20Haemorrhages\">intracranial haemorrhage</a></li><li style=\"margin:3px 0;\"><b>Fever + meningism</b> &rarr; <b>meningitis / encephalitis</b>; <b>&gt;50 + scalp tenderness / jaw claudication</b> &rarr; <b>GCA</b> (steroids + ESR, see <a class=\"cp-dx\" href=\"#signs/MSK/Jaw Claudication & Scalp Tenderness\">jaw claudication</a>)</li><li style=\"margin:3px 0;\"><b>Progressive + worse on waking / Valsalva + vomiting / focal signs / papilloedema</b> &rarr; <b>raised ICP / tumour / abscess</b> (see <a class=\"cp-dx\" href=\"#conditions/NEUROLOGY%20%2F%20NEUROSURGERY/Brain%20Tumours\">brain tumour</a>, <a class=\"cp-dx\" href=\"#conditions/NEUROLOGY%20%2F%20NEUROSURGERY/Brain%20Abscess\">brain abscess</a>)</li></ul></div></div><div class=\"cp-kill\" style=\"--kc:var(--rn-green,#1F8B5E);--kcb:var(--rn-green-bg,#E6F6EF);\"><div class=\"cp-kill-top\"><span class=\"cp-kill-ic\">🟣</span><span class=\"cp-kill-name\">Migraine</span></div><div class=\"cp-kill-desc\"><ul style=\"margin:6px 0 0;padding-left:17px;list-style:disc;\"><li style=\"margin:3px 0;\"><b>Episodic</b>, often <b>unilateral throbbing</b>, <b>4&ndash;72&nbsp;h</b>, with <b>nausea, photophobia / phonophobia</b>, worse on activity</li><li style=\"margin:3px 0;\">&plusmn; <b>aura</b> (visual zig-zags / scotoma, spreading over &lt;60&nbsp;min then resolving); identifiable <b>triggers</b></li><li style=\"margin:3px 0;\">Acute: <b>triptan + NSAID</b>; prophylaxis (propranolol, amitriptyline, topiramate) if frequent (see <a class=\"cp-dx\" href=\"#conditions/NEUROLOGY%20%2F%20NEUROSURGERY/Headaches\">primary headaches</a>)</li></ul></div></div><div class=\"cp-kill\" style=\"--kc:var(--rn-amber,#B86B00);--kcb:var(--rn-amber-bg,#FEF5E4);\"><div class=\"cp-kill-top\"><span class=\"cp-kill-ic\">🟢</span><span class=\"cp-kill-name\">Tension-type &amp; medication-overuse</span></div><div class=\"cp-kill-desc\"><ul style=\"margin:6px 0 0;padding-left:17px;list-style:disc;\"><li style=\"margin:3px 0;\"><b>Tension-type</b>: <b>bilateral, band-like, pressing</b>, mild&ndash;moderate, <b>no nausea</b>, not aggravated by activity</li><li style=\"margin:3px 0;\"><b>Medication-overuse headache</b>: <b>chronic daily</b> headache with regular <b>analgesic / triptan overuse</b> &mdash; treat by withdrawal</li><li style=\"margin:3px 0;\">Reassurance, simple analgesia, address triggers / stress; limit acute medication days</li></ul></div></div><div class=\"cp-kill\" style=\"--kc:var(--rn-purple,#6B45B8);--kcb:var(--rn-purple-bg,#F0EBFF);\"><div class=\"cp-kill-top\"><span class=\"cp-kill-ic\">🔵</span><span class=\"cp-kill-name\">Cluster &amp; other TACs / neuralgia</span></div><div class=\"cp-kill-desc\"><ul style=\"margin:6px 0 0;padding-left:17px;list-style:disc;\"><li style=\"margin:3px 0;\"><b>Cluster headache</b>: <b>severe unilateral orbital / temporal</b> pain, <b>15&ndash;180&nbsp;min</b>, in bouts, often <b>nocturnal</b>; the patient is <b>restless / agitated</b></li><li style=\"margin:3px 0;\"><b>Autonomic features</b>: ipsilateral <b>lacrimation, rhinorrhoea, ptosis / miosis</b> (partial Horner&rsquo;s); acute Rx <b>high-flow O&#8322; + SC sumatriptan</b></li><li style=\"margin:3px 0;\"><b>Trigeminal neuralgia</b>: <b>paroxysmal electric-shock</b> facial pain in a trigeminal division, trigger zones &mdash; <b>carbamazepine</b></li></ul></div></div><div class=\"cp-kill\" style=\"--kc:var(--rn-blue,#3B7DD8);--kcb:var(--rn-blue-bg,#EBF2FF);\"><div class=\"cp-kill-top\"><span class=\"cp-kill-ic\">🩺</span><span class=\"cp-kill-name\">Assess &amp; investigate</span></div><div class=\"cp-kill-desc\"><ul style=\"margin:6px 0 0;padding-left:17px;list-style:disc;\"><li style=\"margin:3px 0;\"><b>Examine</b>: BP, temperature, <b>fundoscopy</b> (papilloedema), neck stiffness, focal neurology, temporal arteries</li><li style=\"margin:3px 0;\"><b>Bloods</b>: <b>ESR / CRP</b> (GCA); <b>CT head</b> for thunderclap / focal signs, <b>LP</b> after CT for SAH (xanthochromia) and meningitis</li><li style=\"margin:3px 0;\"><b>MRI / MR venography</b> for CVST or posterior-fossa / progressive headache; check <b>carbon monoxide</b> if household / seasonal</li></ul></div></div></div><div class=\"cp-pearl\">Headache is a <b>screening</b> problem first: run the red flags &mdash; <b>thunderclap</b> (SAH), <b>fever + meningism</b> (meningitis), <b>&gt;50 + scalp tenderness</b> (GCA), <b>progressive + papilloedema</b> (raised ICP / tumour). Only once these are excluded do you pattern-match the <b>primary</b> headache by <b>site, duration and associated features</b>.</div></div></div><div class=\"cp-step\" id=\"s-2\"><div class=\"cp-step-h\"><span class=\"cp-num\">2</span><span class=\"cp-title\">What it points to</span></div><div class=\"cp-step-body\"><div class=\"cp-clues\"><div class=\"cp-clue\"><div class=\"cp-when\"><b>Thunderclap &mdash; worst-ever, peaks in seconds</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/NEUROLOGY%20%2F%20NEUROSURGERY/Intracranial%20Haemorrhages\">Subarachnoid haemorrhage</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Fever + neck stiffness + photophobia + rash</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/NEUROLOGY%20%2F%20NEUROSURGERY/Meningitis%20%2F%20Encephalitis\">Meningitis / encephalitis</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>New headache &gt;50 + scalp tenderness + jaw claudication</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/MSK%20%2F%20RHEUMATOLOGY/Vasculitis\">Giant cell arteritis</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Progressive + worse on waking / coughing + vomiting + papilloedema</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/NEUROLOGY%20%2F%20NEUROSURGERY/Brain%20Tumours\">Raised ICP / tumour</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Headache + seizures / focal deficit (± pregnancy, thrombophilia)</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/NEUROLOGY%20%2F%20NEUROSURGERY/Cerebral%20Venous%20Sinus%20Thrombosis\">Cerebral venous sinus thrombosis</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Papilloedema in a young obese woman, visual obscurations</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/NEUROLOGY%20%2F%20NEUROSURGERY/Idiopathic%20Intracranial%20Hypertension\">Idiopathic intracranial hypertension</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Unilateral throbbing, 4&ndash;72 h, nausea, photophobia, ± aura</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/NEUROLOGY%20%2F%20NEUROSURGERY/Headaches\">Migraine</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Bilateral band-like pressing, no nausea</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/NEUROLOGY%20%2F%20NEUROSURGERY/Headaches\">Tension-type headache</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Severe unilateral orbital pain, autonomic features, restless</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/NEUROLOGY%20%2F%20NEUROSURGERY/Headaches\">Cluster headache</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Headache in several household members, worse at home / winter</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><span class=\"cp-dx cp-dx-off\">Carbon monoxide poisoning</span></div></div></div><div class=\"cp-pearl\"><b>Onset and company sort it:</b> a <b>sudden thunderclap</b> is vascular (SAH) until proven otherwise; <b>fever + meningism</b> is infective; <b>age &gt;50 with scalp / jaw</b> symptoms is GCA; <b>progressive with papilloedema</b> is raised ICP. Episodic unilateral throbbing = <b>migraine</b>; band-like = <b>tension</b>; orbital with autonomic features = <b>cluster</b>.</div></div></div><div class=\"cp-step\" id=\"s-3\"><div class=\"cp-step-h\"><span class=\"cp-num\">3</span><span class=\"cp-title\">Assess &amp; investigate</span></div><div class=\"cp-step-body\"><div class=\"cp-sub\">At the bedside &mdash; screen red flags, then examine</div><div class=\"cp-bed cp-bed-hot\"><div class=\"cp-bed-h\"><span class=\"cp-bed-n\">Screen the red flags</span></div><div class=\"cp-reads\"><span class=\"cp-read\">Ask about <b>thunderclap onset</b>, <b>fever / neck stiffness</b>, <b>age &gt;50 + scalp / jaw</b> symptoms, <b>progressive</b> pattern and <b>Valsalva</b> aggravation; check <b>GCS</b> and for <b>focal deficit</b></span></div></div><div class=\"cp-bed\"><div class=\"cp-bed-h\"><span class=\"cp-bed-n\">Examine</span></div><div class=\"cp-reads\"><span class=\"cp-read\"><b>Fundoscopy</b> (papilloedema), <b>neck stiffness / Kernig&rsquo;s</b>, <b>temporal arteries</b>, <b>BP and temperature</b>, cranial nerves and limbs (see <a class=\"cp-dx\" href=\"#signs/NEUROLOGICAL/Raised Intracranial Pressure (Signs)\">raised-ICP signs</a>)</span></div></div><div class=\"cp-bed\"><div class=\"cp-bed-h\"><span class=\"cp-bed-n\">Investigate</span></div><div class=\"cp-reads\"><span class=\"cp-read\"><b>ESR / CRP</b> (GCA); <b>CT head</b> then <b>LP</b> for SAH (xanthochromia) / meningitis; <b>MRI / MRV</b> for CVST or progressive headache; consider <b>carboxyhaemoglobin</b></span></div></div><div class=\"cp-sub\">Then &mdash; confirm the cause</div><div class=\"cp-confirm\"><span class=\"cp-cfm\"><span class=\"cp-dxn\">Subarachnoid haemorrhage</span> <span class=\"cp-ar\">&rarr;</span> <span class=\"cp-tst\"><b>CT head</b> &plusmn; <b>LP</b> (xanthochromia)</span></span><span class=\"cp-cfm\"><span class=\"cp-dxn\">Meningitis</span> <span class=\"cp-ar\">&rarr;</span> <span class=\"cp-tst\"><b>LP</b> (after CT if indicated)</span></span><span class=\"cp-cfm\"><span class=\"cp-dxn\">Giant cell arteritis</span> <span class=\"cp-ar\">&rarr;</span> <span class=\"cp-tst\"><b>ESR / CRP</b> + temporal artery biopsy / USS</span></span><span class=\"cp-cfm\"><span class=\"cp-dxn\">Raised ICP / tumour</span> <span class=\"cp-ar\">&rarr;</span> <span class=\"cp-tst\"><b>CT / MRI head</b></span></span><span class=\"cp-cfm\"><span class=\"cp-dxn\">CVST</span> <span class=\"cp-ar\">&rarr;</span> <span class=\"cp-tst\"><b>CT / MR venography</b></span></span></div><div class=\"cp-pearl\"><b>The rules that carry it:</b> exclude the <b>secondary killers</b> first &mdash; <b>thunderclap = SAH</b> (CT then LP), <b>fever + meningism = meningitis</b>, <b>&gt;50 + scalp / jaw = GCA</b> (steroids before biopsy), <b>progressive + papilloedema = raised ICP / tumour</b>. Then diagnose the <b>primary</b> headache clinically and treat it.</div></div></div><div class=\"cp-hand\" id=\"s-hand\"><span>➡️</span><span>Landed on a diagnosis? Open its <b>note</b> for investigations, management &amp; prognosis &mdash; every blue link above jumps straight there. <b>This is where the conditions library takes over.</b></span></div><div class=\"cp-step\" id=\"s-map\"><div class=\"cp-step-h\"><span class=\"cp-mapic\">🗺️</span><span class=\"cp-title\">In summary</span></div><div class=\"cp-step-body\"><div class=\"cp-flow\"><div class=\"cp-node start\">HEADACHE</div><div class=\"cp-dn\">▼</div><div class=\"cp-node decision\">Screen the red flags (onset, fever/meningism, age &gt;50 + scalp/jaw, progressive + papilloedema)</div><div class=\"cp-dn\">▼</div><div class=\"cp-node danger\">Any red flag? &rarr; investigate for a secondary cause urgently</div><div class=\"cp-dn\">▼</div><div class=\"cp-branchbox\"><div class=\"cp-branchcols\"><div class=\"cp-col\"><div class=\"cp-feat\">Thunderclap</div><div class=\"cp-cdn\">▼</div><a href=\"#conditions/NEUROLOGY%20%2F%20NEUROSURGERY/Intracranial%20Haemorrhages\" class=\"cp-dx-node tier-red cp-dxlink\">Subarachnoid haemorrhage</a><div class=\"cp-cdn\">▼</div><div class=\"cp-test\">CT then LP</div></div><div class=\"cp-col\"><div class=\"cp-feat\">Fever + meningism</div><div class=\"cp-cdn\">▼</div><a href=\"#conditions/NEUROLOGY%20%2F%20NEUROSURGERY/Meningitis%20%2F%20Encephalitis\" class=\"cp-dx-node tier-red cp-dxlink\">Meningitis</a><div class=\"cp-cdn\">▼</div><div class=\"cp-test\">LP</div></div><div class=\"cp-col\"><div class=\"cp-feat\">&gt;50 + scalp / jaw</div><div class=\"cp-cdn\">▼</div><a href=\"#conditions/MSK%20%2F%20RHEUMATOLOGY/Vasculitis\" class=\"cp-dx-node tier-red cp-dxlink\">Giant cell arteritis</a><div class=\"cp-cdn\">▼</div><div class=\"cp-test\">ESR + steroids</div></div><div class=\"cp-col\"><div class=\"cp-feat\">Progressive + papilloedema</div><div class=\"cp-cdn\">▼</div><a href=\"#conditions/NEUROLOGY%20%2F%20NEUROSURGERY/Brain%20Tumours\" class=\"cp-dx-node tier-amber cp-dxlink\">Raised ICP / tumour</a><div class=\"cp-cdn\">▼</div><div class=\"cp-test\">CT / MRI</div></div><div class=\"cp-col\"><div class=\"cp-feat\">Episodic, no red flags</div><div class=\"cp-cdn\">▼</div><a href=\"#conditions/NEUROLOGY%20%2F%20NEUROSURGERY/Headaches\" class=\"cp-dx-node tier-green cp-dxlink\">Primary headache</a><div class=\"cp-cdn\">▼</div><div class=\"cp-test\">clinical diagnosis</div></div></div></div><div class=\"cp-dn\">▼</div><div class=\"cp-node work\">No red flags &rarr; diagnose the primary headache by site, duration &amp; features</div><div class=\"cp-dn\">▼</div><div class=\"cp-node final\">➡️ Open the condition note &mdash; Ix &middot; management &middot; prognosis</div></div></div></div></div>"}