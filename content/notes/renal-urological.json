{"RENAL / UROLOGICAL__Haematuria": "<div class=\"cp\"><div class=\"cp\"><style>.cp *{box-sizing:border-box;}.cp{font-family:var(--sans,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif);color:var(--rn-text,#1E2640);line-height:1.5;}.cp-lead{font-size:14px;line-height:1.75;color:var(--rn-sub,#5A6480);margin:2px 0 14px;background:var(--rn-card,#fff);border:1.5px solid var(--rn-border,#E2E6F0);border-radius:12px;padding:16px 18px;box-shadow:0 1px 4px rgba(0,0,0,.05);}.cp-lead b{color:var(--rn-text,#1E2640);}.cp-warn{display:flex;gap:10px;background:var(--rn-red-bg,#FDEAEA);border:1.5px solid #F2BABA;color:var(--rn-text,#1E2640);border-radius:10px;padding:14px 18px;font-size:13.5px;line-height:1.7;margin-bottom:12px;}.cp-warn b{color:var(--rn-red,#C93535);}.cp-warn .cp-warn-ic{font-size:16px;line-height:1.4;}.cp-step{margin-bottom:12px;background:var(--rn-card,#fff);border:1.5px solid var(--rn-border,#E2E6F0);border-radius:12px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.05);}.cp-step-h{display:flex;align-items:center;gap:11px;padding:12px 20px;border-bottom:1.5px solid var(--rn-border,#E2E6F0);background:var(--rn-blue-bg,#EBF2FF);}.cp-step-body{padding:20px;}.cp-step-body>.cp-sub:first-child{margin-top:0;}.cp-num{flex:none;width:24px;height:24px;border-radius:50%;background:var(--rn-blue,#3B7DD8);color:#fff;font-size:13px;font-weight:800;display:flex;align-items:center;justify-content:center;font-family:var(--mono,'SF Mono',SFMono-Regular,ui-monospace,Menlo,Consolas,monospace);}.cp-title{font-family:var(--mono,'SF Mono',SFMono-Regular,ui-monospace,Menlo,Consolas,monospace);font-size:12px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--rn-blue,#3B7DD8);}.cp-killgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(215px,1fr));gap:11px;}.cp-kill{border:1px solid var(--rn-border,#E2E6F0);border-left:4px solid var(--kc,var(--rn-blue,#3B7DD8));border-radius:11px;padding:0;overflow:hidden;background:var(--rn-card,#fff);}.cp-kill-top{display:flex;align-items:center;gap:8px;padding:9px 13px;background:var(--kcb,var(--rn-blue-bg,#EBF2FF));border-bottom:1px solid var(--rn-border,#E2E6F0);}.cp-kill-ic{font-size:15px;}.cp-kill-name{font-size:14px;font-weight:800;color:var(--kc,var(--rn-text,#1E2640));}.cp-kill-desc{padding:11px 13px;font-size:12.5px;line-height:1.5;color:var(--rn-sub,#5A6480);}.cp-kill .cp-dx{margin-top:9px;}.cp-clue{display:flex;align-items:center;gap:12px;padding:11px 2px;border-bottom:1px solid var(--rn-border,#EEF1F7);}.cp-clue:last-child{border-bottom:none;}.cp-when{flex:1 1 44%;font-size:13.5px;font-weight:700;color:var(--rn-text,#1E2640);}.cp-arrow{flex:none;color:var(--rn-blue,#3B7DD8);font-weight:700;}.cp-then{flex:1 1 52%;display:flex;flex-wrap:wrap;gap:6px;}.cp-bed{padding:12px 14px;border-radius:10px;background:#F1F3F8;border:1.5px solid var(--rn-border,#E2E6F0);margin-bottom:8px;}.cp-bed-hot{background:var(--rn-red-bg,#FDEAEA);border-color:#F2BABA;}.cp-bed-h{display:flex;align-items:baseline;gap:8px;margin-bottom:7px;}.cp-bed-n{font-family:var(--mono,'SF Mono',SFMono-Regular,ui-monospace,Menlo,Consolas,monospace);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--rn-text,#1E2640);}.cp-bed-hot .cp-bed-n{color:var(--rn-red,#C93535);}.cp-bed-when{font-size:11px;color:var(--rn-muted,#9AA4B2);font-style:italic;}.cp-reads{display:flex;flex-wrap:wrap;gap:6px;}.cp-read{font-size:11.5px;line-height:1.35;background:var(--rn-card,#fff);border:1px solid var(--rn-border,#E2E6F0);border-radius:7px;padding:4px 9px;color:var(--rn-sub,#5A6480);}.cp-read b{color:var(--rn-text,#1E2640);font-weight:700;}.cp-read .cp-ar{color:var(--rn-blue,#3B7DD8);}.cp-bed-hot .cp-read{border-color:#F3B7B7;}.cp-sub{font-family:var(--mono,'SF Mono',SFMono-Regular,ui-monospace,Menlo,Consolas,monospace);font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--rn-text,#1E2640);margin:16px 0 10px;}.cp-confirm{display:flex;flex-wrap:wrap;gap:7px;}.cp-cfm{font-size:12px;line-height:1.4;background:var(--rn-blue-bg,#EBF2FF);border:1px solid #D6E4FA;border-radius:8px;padding:5px 10px;}.cp-cfm .cp-dxn{font-weight:800;color:var(--rn-text,#1E2640);}.cp-cfm .cp-ar{color:var(--rn-blue,#3B7DD8);}.cp-cfm .cp-tst{color:var(--rn-blue,#3B7DD8);font-weight:600;}.cp-pearl{background:var(--rn-yellow-bg,#FFFBE6);border:1.5px solid #E8D48A;border-left:4px solid var(--rn-yellow,#8A6C00);border-radius:0 10px 10px 0;padding:12px 16px;font-size:13.5px;line-height:1.6;color:var(--rn-text,#1E2640);margin-top:14px;}.cp-pearl b{color:var(--rn-text,#1E2640);}.cp-sysgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(255px,1fr));gap:11px;}.cp-sys{border:1px solid var(--rn-border,#E2E6F0);border-left:4px solid;border-radius:11px;padding:12px 14px;background:var(--rn-card,#fff);}.cp-sys.tier-red{border-left-color:var(--rn-red,#C93535);}.cp-sys.tier-amber{border-left-color:var(--rn-amber,#B86B00);}.cp-sys.tier-green{border-left-color:var(--rn-green,#1F8B5E);}.cp-sys-h{font-family:var(--mono,'SF Mono',SFMono-Regular,ui-monospace,Menlo,Consolas,monospace);font-size:11px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--rn-text,#1E2640);margin-bottom:9px;}.cp-sys-dx{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px;}.cp-sys-d{font-size:12px;line-height:1.45;color:var(--rn-sub,#5A6480);}.cp-dx{display:inline-block;font-size:12.5px;font-weight:600;text-decoration:none;padding:3px 10px;border-radius:999px;background:var(--rn-blue-bg,#EBF2FF);color:var(--rn-blue,#3B7DD8);border:1px solid transparent;transition:all .13s;}.cp-dx:hover{border-color:var(--rn-blue,#3B7DD8);}.cp-dx-off{background:#F1F3F8;color:var(--rn-sub,#7A8396);}.cp-hand{display:flex;gap:10px;background:var(--rn-blue-bg,#EBF2FF);border:1.5px solid #B0CCEF;border-radius:10px;padding:14px 18px;font-size:13.5px;line-height:1.7;color:var(--rn-text,#1E2640);margin-top:26px;}.cp-hand b{color:var(--rn-blue,#3B7DD8);}.cp-mapic{font-size:18px;line-height:1;}.cp-flow{display:flex;flex-direction:column;align-items:center;text-align:center;}.cp-dn{color:var(--rn-border,#C7CEDB);font-size:13px;line-height:1;margin:5px 0;}.cp-node{border-radius:11px;padding:10px 18px;font-weight:700;font-size:13.5px;max-width:560px;background:var(--rn-card,#fff);border:1.5px solid var(--rn-border,#E2E6F0);color:var(--rn-text,#1E2640);}.cp-node.start{background:var(--rn-blue-bg,#EBF2FF);border-color:#B0CCEF;color:var(--rn-blue,#3B7DD8);font-weight:800;letter-spacing:.06em;}.cp-node.danger{background:var(--rn-red-bg,#FDEAEA);border-color:#EDBFBF;color:var(--rn-red,#C93535);}.cp-node-sub{font-weight:500;font-size:10.5px;margin-top:3px;opacity:.9;}.cp-flowlabel{font-size:11px;color:var(--rn-muted,#9AA4B2);font-style:italic;margin:6px 0;}.cp-node.decision{background:var(--rn-amber-bg,#FEF5E4);border-color:#E8CE93;color:var(--rn-amber,#B86B00);}.cp-node.work{background:var(--rn-blue-bg,#EBF2FF);border-color:#B0CCEF;color:var(--rn-blue,#3B7DD8);font-weight:800;}.cp-node.final{background:var(--rn-blue-bg,#EBF2FF);border-color:#B7CEF0;color:var(--rn-blue,#3B7DD8);}.cp-branchbox{width:100%;border:1.5px dashed var(--rn-border,#D8DEEA);border-radius:14px;padding:14px 12px;background:transparent;}.cp-branchcols{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;}.cp-col{display:flex;flex-direction:column;align-items:center;flex:1 1 128px;max-width:150px;}.cp-feat{font-size:11px;font-weight:600;background:#F1F3F8;border:1px solid var(--rn-border,#E2E6F0);border-radius:8px;padding:6px 8px;width:100%;min-height:42px;display:flex;align-items:center;justify-content:center;color:var(--rn-sub,#5A6480);}.cp-cdn{color:var(--rn-border,#C7CEDB);font-size:10px;margin:3px 0;}.cp-dx-node{font-size:12px;font-weight:800;border-radius:8px;padding:7px 8px;width:100%;border:1px solid;text-decoration:none;}.cp-dx-node.tier-red{background:var(--rn-red-bg,#FDEAEA);border-color:#EDC6C6;color:var(--rn-red,#C93535);}.cp-dx-node.tier-amber{background:var(--rn-amber-bg,#FEF5E4);border-color:#EAD4A4;color:var(--rn-amber,#B86B00);}.cp-dx-node.tier-green{background:var(--rn-green-bg,#E6F6EF);border-color:#B9E2CD;color:var(--rn-green,#1F8B5E);}.cp-test{font-size:10.5px;color:var(--rn-sub,#7A8396);font-weight:600;margin-top:5px;}.cp-dxlink{display:block;text-decoration:none;cursor:pointer;}.cp-dxlink:hover{box-shadow:0 0 0 2px currentColor inset;}</style><div class=\"cp-lead\"><b>Haematuria</b> is blood in the urine. Three questions frame it. <b>(1) Is it really blood?</b> &mdash; a positive dipstick needs <b>red cells confirmed on microscopy</b>; a positive dip with <b>no red cells</b> is <b>myoglobin or haemoglobin</b>, and red urine can be <b>beetroot, rifampicin</b> or menstrual contamination. <b>(2) Visible or non-visible, painful or painless?</b> <b>(3) What is the source?</b> &mdash; <b>urological</b> (tumour, stone, infection: clots, timing within the stream, colic) versus <b>glomerular</b> (<b>dysmorphic red cells, red-cell casts, proteinuria, hypertension, AKI</b>). The rule that carries the topic: <b>painless visible haematuria in an adult is a urological cancer until proven otherwise</b> (see <a class=\"cp-dx\" href=\"#conditions/UROLOGY/Bladder%20Cancer\">bladder cancer</a>, <a class=\"cp-dx\" href=\"#conditions/UROLOGY/Renal%20Cell%20Carcinoma\">renal cell carcinoma</a>), while a <b>nephritic</b> picture is a <b>glomerulonephritis</b> that can cost the kidneys in days (see <a class=\"cp-dx\" href=\"#conditions/RENAL/Glomerulonephritis%20%28nephrotic%2Fnephritic%29\">glomerulonephritis</a>).</div><div class=\"cp-warn\"><span class=\"cp-warn-ic\">🚨</span><span><b>Two haematurias are emergencies.</b> <b>Painless visible haematuria</b> &mdash; especially <b>aged &ge;45</b>, a <b>smoker</b> or with <b>aromatic-amine / dye</b> exposure &mdash; is <b>bladder / renal / upper-tract cancer</b> until excluded &rarr; <b>2-week-wait</b> referral for <b>flexible cystoscopy + CT urogram</b> (see <a class=\"cp-dx\" href=\"#conditions/UROLOGY/Bladder%20Cancer\">bladder cancer</a>). A <b>nephritic</b> picture &mdash; haematuria with <b>proteinuria, hypertension and rising creatinine</b> (&plusmn; red-cell casts, dysmorphic red cells) &mdash; is a <b>glomerulonephritis / rapidly progressive GN / vasculitis</b> that can <b>destroy nephrons within days</b> &rarr; <b>urgent nephrology</b> and immunology (<b>ANCA, anti-GBM, complement</b>, see <a class=\"cp-dx\" href=\"#conditions/MSK%20%2F%20RHEUMATOLOGY/Vasculitis\">vasculitis</a>, <a class=\"cp-dx\" href=\"#conditions/RENAL/Acute%20Kidney%20Injury\">AKI</a>). Also act on <b>clot retention</b> (catheter / irrigation) and an <b>infected obstructed system</b> (fever + loin pain + obstruction &rarr; emergency decompression).</span></div><div style=\"font-size:22px;\"><div style=\"font-size:22px;\">📷</div><div style=\"font-size:12.5px;font-weight:700;\">Image placeholder &mdash; the haematuria algorithm: confirm red cells on microscopy, then split urological (tumour / stone / infection &mdash; clots, painless visible = cancer) from glomerular (dysmorphic red cells, red-cell casts, proteinuria, hypertension, AKI), with the 2-week-wait and nephritic pathways</div><div style=\"font-family:var(--mono);font-size:10.5px;text-transform:uppercase;letter-spacing:.05em;color:var(--rn-muted,#9AA4B2);margin-top:10px;\">link to be uploaded</div></div><div class=\"cp-step\" id=\"s-1\"><div class=\"cp-step-h\"><span class=\"cp-num\">1</span><span class=\"cp-title\">Triage &amp; screen</span></div><div class=\"cp-step-body\"><div class=\"cp-killgrid\"><div class=\"cp-kill\" style=\"--kc:var(--rn-blue,#3B7DD8);--kcb:var(--rn-blue-bg,#EBF2FF);\"><div class=\"cp-kill-top\"><span class=\"cp-kill-ic\">🔍</span><span class=\"cp-kill-name\">Is it really blood?</span></div><div class=\"cp-kill-desc\"><ul style=\"margin:6px 0 0;padding-left:17px;list-style:disc;\"><li style=\"margin:3px 0;\"><b>Confirm red cells on microscopy</b> &mdash; a positive dipstick alone is not enough</li><li style=\"margin:3px 0;\"><b>Positive dip, no red cells</b> &rarr; <b>myoglobinuria</b> (rhabdomyolysis) or <b>haemoglobinuria</b> (haemolysis)</li><li style=\"margin:3px 0;\">Exclude <b>beetroot, rifampicin, doxorubicin</b> and <b>menstrual</b> contamination</li></ul></div></div><div class=\"cp-kill\" style=\"--kc:var(--rn-red,#C93535);--kcb:var(--rn-red-bg,#FDEAEA);\"><div class=\"cp-kill-top\"><span class=\"cp-kill-ic\">🚩</span><span class=\"cp-kill-name\">Painless visible haematuria = cancer</span></div><div class=\"cp-kill-desc\"><ul style=\"margin:6px 0 0;padding-left:17px;list-style:disc;\"><li style=\"margin:3px 0;\"><b>Bladder cancer</b> (commonest), <b>renal cell carcinoma</b>, <b>upper-tract TCC</b>, prostate &mdash; <b>painless</b> and <b>visible</b> is the alarm</li><li style=\"margin:3px 0;\">Risk: <b>age &ge;45</b>, <b>smoking</b>, <b>aromatic amines / dyes</b>, prior pelvic radiotherapy, cyclophosphamide</li><li style=\"margin:3px 0;\"><b>2-week-wait</b> &rarr; <b>flexible cystoscopy + CT urogram</b> (see <a class=\"cp-dx\" href=\"#conditions/UROLOGY/Bladder%20Cancer\">bladder cancer</a>, <a class=\"cp-dx\" href=\"#conditions/UROLOGY/Renal%20Cell%20Carcinoma\">RCC</a>)</li></ul></div></div><div class=\"cp-kill\" style=\"--kc:var(--rn-red,#C93535);--kcb:var(--rn-red-bg,#FDEAEA);\"><div class=\"cp-kill-top\"><span class=\"cp-kill-ic\">🚩</span><span class=\"cp-kill-name\">The nephritic emergency</span></div><div class=\"cp-kill-desc\"><ul style=\"margin:6px 0 0;padding-left:17px;list-style:disc;\"><li style=\"margin:3px 0;\"><b>Dysmorphic red cells / red-cell casts</b> + <b>proteinuria</b> + <b>hypertension</b> + <b>AKI</b> = a <b>glomerulonephritis</b></li><li style=\"margin:3px 0;\"><b>Rapidly progressive GN / vasculitis</b> can lose the kidneys in days &rarr; <b>urgent nephrology</b> (see <a class=\"cp-dx\" href=\"#conditions/RENAL/Glomerulonephritis%20%28nephrotic%2Fnephritic%29\">glomerulonephritis</a>)</li><li style=\"margin:3px 0;\">Send <b>ANCA, anti-GBM, complement, ANA</b> and consider a <b>renal biopsy</b> (see <a class=\"cp-dx\" href=\"#conditions/MSK%20%2F%20RHEUMATOLOGY/Vasculitis\">vasculitis</a>)</li></ul></div></div><div class=\"cp-kill\" style=\"--kc:var(--rn-amber,#B86B00);--kcb:var(--rn-amber-bg,#FEF5E4);\"><div class=\"cp-kill-top\"><span class=\"cp-kill-ic\">🟣</span><span class=\"cp-kill-name\">Urological, non-malignant</span></div><div class=\"cp-kill-desc\"><ul style=\"margin:6px 0 0;padding-left:17px;list-style:disc;\"><li style=\"margin:3px 0;\"><b>Stones</b>: colicky <b>loin-to-groin</b> pain + haematuria (see <a class=\"cp-dx\" href=\"#conditions/UROLOGY/Renal%20Stone%20Disease\">renal stone disease</a>, <a class=\"cp-dx\" href=\"#signs/RENAL%20%2F%20UROLOGICAL/Loin-to-Groin Pain\">loin-to-groin pain</a>)</li><li style=\"margin:3px 0;\"><b>Infection</b>: cystitis / UTI (dysuria, frequency) or <b>pyelonephritis</b> (fever, loin pain) (see <a class=\"cp-dx\" href=\"#conditions/UROLOGY/Urinary%20Tract%20Infection%20%28UTI%29\">UTI</a>, <a class=\"cp-dx\" href=\"#conditions/UROLOGY/Pyelonephritis\">pyelonephritis</a>)</li><li style=\"margin:3px 0;\"><b>BPH</b>, trauma / catheter, <b>schistosomiasis</b> (travel, terminal haematuria) (see <a class=\"cp-dx\" href=\"#conditions/UROLOGY/Benign%20Prostatic%20Hyperplasia%20%28BPH%29\">BPH</a>)</li></ul></div></div><div class=\"cp-kill\" style=\"--kc:var(--rn-green,#1F8B5E);--kcb:var(--rn-green-bg,#E6F6EF);\"><div class=\"cp-kill-top\"><span class=\"cp-kill-ic\">🟢</span><span class=\"cp-kill-name\">Localise &amp; characterise</span></div><div class=\"cp-kill-desc\"><ul style=\"margin:6px 0 0;padding-left:17px;list-style:disc;\"><li style=\"margin:3px 0;\">Timing in the stream: <b>initial</b> = urethral &middot; <b>terminal</b> = bladder base / prostate &middot; <b>total</b> = bladder / upper tract</li><li style=\"margin:3px 0;\"><b>Clots</b> mean a <b>urological</b> (not glomerular) source; <b>worm-like</b> clots suggest the upper tract</li><li style=\"margin:3px 0;\"><b>Colic</b> &rarr; stone &middot; <b>painless</b> &rarr; cancer &middot; <b>LUTS</b> &rarr; prostate (see <a class=\"cp-dx\" href=\"#signs/RENAL%20%2F%20UROLOGICAL/Lower Urinary Tract Symptoms\">LUTS</a>)</li></ul></div></div><div class=\"cp-kill\" style=\"--kc:var(--rn-blue,#3B7DD8);--kcb:var(--rn-blue-bg,#EBF2FF);\"><div class=\"cp-kill-top\"><span class=\"cp-kill-ic\">🩺</span><span class=\"cp-kill-name\">Investigate</span></div><div class=\"cp-kill-desc\"><ul style=\"margin:6px 0 0;padding-left:17px;list-style:disc;\"><li style=\"margin:3px 0;\"><b>Urine</b>: dipstick + <b>microscopy</b> (red-cell morphology, casts) + <b>MSU culture</b>; <b>ACR / PCR</b> for proteinuria</li><li style=\"margin:3px 0;\"><b>Bloods</b>: U&amp;E / eGFR, FBC, clotting, and <b>BP</b></li><li style=\"margin:3px 0;\"><b>Imaging</b>: <b>CT urogram</b> (or ultrasound) + <b>flexible cystoscopy</b>; nephrology bloods + <b>biopsy</b> if glomerular</li></ul></div></div></div><div class=\"cp-pearl\"><b>Confirm the blood, then find the source.</b> Prove <b>red cells on microscopy</b>, then split <b>urological</b> (clots, colic, painless visible = cancer) from <b>glomerular</b> (dysmorphic cells, casts, proteinuria, hypertension, AKI). <b>Painless visible haematuria = 2-week-wait</b>; a <b>nephritic</b> picture = <b>urgent nephrology</b>.</div></div></div><div class=\"cp-step\" id=\"s-2\"><div class=\"cp-step-h\"><span class=\"cp-num\">2</span><span class=\"cp-title\">What it points to</span></div><div class=\"cp-step-body\"><div class=\"cp-clues\"><div class=\"cp-clue\"><div class=\"cp-when\"><b>Painless visible haematuria, older / smoker</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/UROLOGY/Bladder%20Cancer\">Bladder cancer</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Painless haematuria + flank mass / weight loss</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/UROLOGY/Renal%20Cell%20Carcinoma\">Renal cell carcinoma</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Colicky loin-to-groin pain + haematuria</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/UROLOGY/Renal%20Stone%20Disease\">Renal / ureteric stone</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Dysuria + frequency + cloudy urine</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/UROLOGY/Urinary%20Tract%20Infection%20%28UTI%29\">UTI / cystitis</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Fever + loin pain + rigors</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/UROLOGY/Pyelonephritis\">Pyelonephritis</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Haematuria + proteinuria + hypertension + AKI</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/RENAL/Glomerulonephritis%20%28nephrotic%2Fnephritic%29\">Glomerulonephritis (nephritic)</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Visible haematuria a day or two after a sore throat (synpharyngitic)</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/RENAL/Glomerulonephritis%20%28nephrotic%2Fnephritic%29\">IgA nephropathy</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Older man with LUTS + haematuria</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/UROLOGY/Benign%20Prostatic%20Hyperplasia%20%28BPH%29\">BPH / prostate &mdash; also exclude cancer</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Travel to an endemic area, terminal haematuria</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><span class=\"cp-dx cp-dx-off\">Schistosomiasis</span></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Positive dip, no red cells, muscle pain / dark urine</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><span class=\"cp-dx cp-dx-off\">Myoglobinuria (rhabdomyolysis)</span></div></div></div><div class=\"cp-pearl\"><b>Painless vs painful, clots vs casts.</b> <b>Painless</b> visible blood with <b>clots</b> is <b>urological</b> &mdash; think <b>cancer</b> first; <b>colic</b> means a <b>stone</b>. <b>Dysmorphic red cells and red-cell casts</b> with <b>proteinuria</b> are <b>glomerular</b>. Confirm the blood is real before chasing either.</div></div></div><div class=\"cp-step\" id=\"s-3\"><div class=\"cp-step-h\"><span class=\"cp-num\">3</span><span class=\"cp-title\">Assess &amp; act</span></div><div class=\"cp-step-body\"><div class=\"cp-sub\">At the bedside &mdash; confirm the blood, find the source, refer</div><div class=\"cp-bed\"><div class=\"cp-bed-h\"><span class=\"cp-bed-n\">History &amp; red flags</span></div><div class=\"cp-reads\"><span class=\"cp-read\"><b>Visible vs non-visible</b>, <b>painful vs painless</b>, <b>timing</b> in the stream, <b>clots</b>, LUTS, colic, fever, recent <b>sore throat</b>, <b>smoking / occupation / travel</b>, anticoagulants</span></div></div><div class=\"cp-bed cp-bed-hot\"><div class=\"cp-bed-h\"><span class=\"cp-bed-n\">Examine</span></div><div class=\"cp-reads\"><span class=\"cp-read\"><b>Blood pressure</b>, abdomen and flanks (mass, tenderness), a <b>palpable bladder</b>, <b>DRE</b> for the prostate, and <b>oedema</b> (nephrotic / nephritic); dipstick the urine</span></div></div><div class=\"cp-bed\"><div class=\"cp-bed-h\"><span class=\"cp-bed-n\">Investigate</span></div><div class=\"cp-reads\"><span class=\"cp-read\"><b>Urine microscopy + culture</b> and <b>ACR / PCR</b>; <b>U&amp;E / eGFR</b>, FBC, clotting; <b>CT urogram</b> and <b>flexible cystoscopy</b>; nephrology bloods (<b>ANCA / anti-GBM / complement</b>) and <b>biopsy</b> if glomerular</span></div></div><div class=\"cp-bed\"><div class=\"cp-bed-h\"><span class=\"cp-bed-n\">Act</span></div><div class=\"cp-reads\"><span class=\"cp-read\"><b>2-week-wait urology</b> for suspected cancer; <b>urgent nephrology</b> for a nephritic / rapidly progressive picture; treat <b>UTI</b>; manage the <b>stone</b>; <b>clot retention</b> &rarr; catheter + irrigation</span></div></div><div class=\"cp-sub\">Then &mdash; confirm the cause</div><div class=\"cp-confirm\"><span class=\"cp-cfm\"><span class=\"cp-dxn\">Bladder cancer</span> <span class=\"cp-ar\">&rarr;</span> <span class=\"cp-tst\"><b>flexible cystoscopy + biopsy</b></span></span><span class=\"cp-cfm\"><span class=\"cp-dxn\">Renal / upper-tract cancer</span> <span class=\"cp-ar\">&rarr;</span> <span class=\"cp-tst\"><b>CT urogram</b></span></span><span class=\"cp-cfm\"><span class=\"cp-dxn\">Renal / ureteric stone</span> <span class=\"cp-ar\">&rarr;</span> <span class=\"cp-tst\"><b>non-contrast CT KUB</b></span></span><span class=\"cp-cfm\"><span class=\"cp-dxn\">UTI / pyelonephritis</span> <span class=\"cp-ar\">&rarr;</span> <span class=\"cp-tst\"><b>MSU culture</b></span></span><span class=\"cp-cfm\"><span class=\"cp-dxn\">Glomerulonephritis</span> <span class=\"cp-ar\">&rarr;</span> <span class=\"cp-tst\"><b>urine microscopy + renal biopsy</b></span></span></div><div class=\"cp-pearl\"><b>The rules that carry it:</b> prove <b>red cells on microscopy</b>, then decide <b>urological vs glomerular</b>. <b>Painless visible haematuria = cancer until proven otherwise</b> (2-week-wait, cystoscopy + CT urogram). A <b>nephritic</b> picture (proteinuria, hypertension, AKI, casts) = <b>urgent nephrology</b>. Treat infection and stones, and never blame anticoagulation without excluding a lesion.</div></div></div><div class=\"cp-hand\" id=\"s-hand\"><span>➡️</span><span>Landed on a diagnosis? Open its <b>note</b> for investigations, management &amp; prognosis &mdash; every blue link above jumps straight there. <b>This is where the conditions library takes over.</b></span></div><div class=\"cp-step\" id=\"s-map\"><div class=\"cp-step-h\"><span class=\"cp-mapic\">🗺️</span><span class=\"cp-title\">In summary</span></div><div class=\"cp-step-body\"><div class=\"cp-flow\"><div class=\"cp-node start\">HAEMATURIA &mdash; confirm red cells on microscopy (not just dipstick); visible or non-visible? painful or painless?</div><div class=\"cp-dn\">▼</div><div class=\"cp-node danger\">CAN&rsquo;T-MISS: painless visible haematuria = urological cancer (2-week-wait) &middot; nephritic picture (proteinuria + hypertension + AKI + casts) = urgent nephrology</div><div class=\"cp-dn\">▼</div><div class=\"cp-node decision\">Source: urological (clots, colic, timing in stream) vs glomerular (dysmorphic red cells, red-cell casts, proteinuria)</div><div class=\"cp-dn\">▼</div><div class=\"cp-node decision\">Positive dip but NO red cells &rarr; myoglobinuria / haemoglobinuria, not haematuria</div><div class=\"cp-dn\">▼</div><div class=\"cp-branchbox\"><div class=\"cp-branchcols\"><div class=\"cp-col\"><div class=\"cp-feat\">Painless visible, older / smoker</div><div class=\"cp-cdn\">▼</div><a href=\"#conditions/UROLOGY/Bladder%20Cancer\" class=\"cp-dx-node tier-red cp-dxlink\">Urological cancer</a><div class=\"cp-cdn\">▼</div><div class=\"cp-test\">2WW cystoscopy + CT urogram</div></div><div class=\"cp-col\"><div class=\"cp-feat\">Proteinuria + hypertension + AKI + casts</div><div class=\"cp-cdn\">▼</div><a href=\"#conditions/RENAL/Glomerulonephritis%20%28nephrotic%2Fnephritic%29\" class=\"cp-dx-node tier-red cp-dxlink\">Glomerulonephritis</a><div class=\"cp-cdn\">▼</div><div class=\"cp-test\">nephrology + biopsy</div></div><div class=\"cp-col\"><div class=\"cp-feat\">Colicky loin-to-groin pain</div><div class=\"cp-cdn\">▼</div><a href=\"#conditions/UROLOGY/Renal%20Stone%20Disease\" class=\"cp-dx-node tier-amber cp-dxlink\">Renal / ureteric stone</a><div class=\"cp-cdn\">▼</div><div class=\"cp-test\">CT KUB</div></div><div class=\"cp-col\"><div class=\"cp-feat\">Dysuria + frequency + fever</div><div class=\"cp-cdn\">▼</div><a href=\"#conditions/UROLOGY/Urinary%20Tract%20Infection%20%28UTI%29\" class=\"cp-dx-node tier-amber cp-dxlink\">UTI / pyelonephritis</a><div class=\"cp-cdn\">▼</div><div class=\"cp-test\">MSU culture</div></div><div class=\"cp-col\"><div class=\"cp-feat\">Positive dip, no red cells</div><div class=\"cp-cdn\">▼</div><div class=\"cp-dx-node tier-green\">Myoglobin / haemoglobin</div><div class=\"cp-cdn\">▼</div><div class=\"cp-test\">microscopy / CK</div></div></div></div><div class=\"cp-dn\">▼</div><div class=\"cp-node work\">Urine microscopy + culture + ACR/PCR &middot; U&amp;E / eGFR &middot; CT urogram + flexible cystoscopy &middot; nephrology bloods + biopsy if glomerular</div><div class=\"cp-dn\">▼</div><div class=\"cp-node final\">➡️ Open the condition note &mdash; resection / oncology &middot; stone management &middot; antibiotics &middot; immunosuppression for GN / vasculitis</div></div></div></div></div>"}