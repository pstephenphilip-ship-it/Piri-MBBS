{"GENITOURINARY / SEXUAL HEALTH__Urethral / Vaginal Discharge": "<div class=\"cp\"><div class=\"cp\"><style>.cp *{box-sizing:border-box;}.cp{font-family:var(--sans,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif);color:var(--rn-text,#1E2640);line-height:1.5;}.cp-lead{font-size:14px;line-height:1.75;color:var(--rn-sub,#5A6480);margin:2px 0 14px;background:var(--rn-card,#fff);border:1.5px solid var(--rn-border,#E2E6F0);border-radius:12px;padding:16px 18px;box-shadow:0 1px 4px rgba(0,0,0,.05);}.cp-lead b{color:var(--rn-text,#1E2640);}.cp-warn{display:flex;gap:10px;background:var(--rn-red-bg,#FDEAEA);border:1.5px solid #F2BABA;color:var(--rn-text,#1E2640);border-radius:10px;padding:14px 18px;font-size:13.5px;line-height:1.7;margin-bottom:12px;}.cp-warn b{color:var(--rn-red,#C93535);}.cp-warn .cp-warn-ic{font-size:16px;line-height:1.4;}.cp-step{margin-bottom:12px;background:var(--rn-card,#fff);border:1.5px solid var(--rn-border,#E2E6F0);border-radius:12px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.05);}.cp-step-h{display:flex;align-items:center;gap:11px;padding:12px 20px;border-bottom:1.5px solid var(--rn-border,#E2E6F0);background:var(--rn-blue-bg,#EBF2FF);}.cp-step-body{padding:20px;}.cp-step-body>.cp-sub:first-child{margin-top:0;}.cp-num{flex:none;width:24px;height:24px;border-radius:50%;background:var(--rn-blue,#3B7DD8);color:#fff;font-size:13px;font-weight:800;display:flex;align-items:center;justify-content:center;font-family:var(--mono,'SF Mono',SFMono-Regular,ui-monospace,Menlo,Consolas,monospace);}.cp-title{font-family:var(--mono,'SF Mono',SFMono-Regular,ui-monospace,Menlo,Consolas,monospace);font-size:12px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--rn-blue,#3B7DD8);}.cp-killgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(215px,1fr));gap:11px;}.cp-kill{border:1px solid var(--rn-border,#E2E6F0);border-left:4px solid var(--kc,var(--rn-blue,#3B7DD8));border-radius:11px;padding:0;overflow:hidden;background:var(--rn-card,#fff);}.cp-kill-top{display:flex;align-items:center;gap:8px;padding:9px 13px;background:var(--kcb,var(--rn-blue-bg,#EBF2FF));border-bottom:1px solid var(--rn-border,#E2E6F0);}.cp-kill-ic{font-size:15px;}.cp-kill-name{font-size:14px;font-weight:800;color:var(--kc,var(--rn-text,#1E2640));}.cp-kill-desc{padding:11px 13px;font-size:12.5px;line-height:1.5;color:var(--rn-sub,#5A6480);}.cp-kill .cp-dx{margin-top:9px;}.cp-clue{display:flex;align-items:center;gap:12px;padding:11px 2px;border-bottom:1px solid var(--rn-border,#EEF1F7);}.cp-clue:last-child{border-bottom:none;}.cp-when{flex:1 1 44%;font-size:13.5px;font-weight:700;color:var(--rn-text,#1E2640);}.cp-arrow{flex:none;color:var(--rn-blue,#3B7DD8);font-weight:700;}.cp-then{flex:1 1 52%;display:flex;flex-wrap:wrap;gap:6px;}.cp-bed{padding:12px 14px;border-radius:10px;background:#F1F3F8;border:1.5px solid var(--rn-border,#E2E6F0);margin-bottom:8px;}.cp-bed-hot{background:var(--rn-red-bg,#FDEAEA);border-color:#F2BABA;}.cp-bed-h{display:flex;align-items:baseline;gap:8px;margin-bottom:7px;}.cp-bed-n{font-family:var(--mono,'SF Mono',SFMono-Regular,ui-monospace,Menlo,Consolas,monospace);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--rn-text,#1E2640);}.cp-bed-hot .cp-bed-n{color:var(--rn-red,#C93535);}.cp-bed-when{font-size:11px;color:var(--rn-muted,#9AA4B2);font-style:italic;}.cp-reads{display:flex;flex-wrap:wrap;gap:6px;}.cp-read{font-size:11.5px;line-height:1.35;background:var(--rn-card,#fff);border:1px solid var(--rn-border,#E2E6F0);border-radius:7px;padding:4px 9px;color:var(--rn-sub,#5A6480);}.cp-read b{color:var(--rn-text,#1E2640);font-weight:700;}.cp-read .cp-ar{color:var(--rn-blue,#3B7DD8);}.cp-bed-hot .cp-read{border-color:#F3B7B7;}.cp-sub{font-family:var(--mono,'SF Mono',SFMono-Regular,ui-monospace,Menlo,Consolas,monospace);font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--rn-text,#1E2640);margin:16px 0 10px;}.cp-confirm{display:flex;flex-wrap:wrap;gap:7px;}.cp-cfm{font-size:12px;line-height:1.4;background:var(--rn-blue-bg,#EBF2FF);border:1px solid #D6E4FA;border-radius:8px;padding:5px 10px;}.cp-cfm .cp-dxn{font-weight:800;color:var(--rn-text,#1E2640);}.cp-cfm .cp-ar{color:var(--rn-blue,#3B7DD8);}.cp-cfm .cp-tst{color:var(--rn-blue,#3B7DD8);font-weight:600;}.cp-pearl{background:var(--rn-yellow-bg,#FFFBE6);border:1.5px solid #E8D48A;border-left:4px solid var(--rn-yellow,#8A6C00);border-radius:0 10px 10px 0;padding:12px 16px;font-size:13.5px;line-height:1.6;color:var(--rn-text,#1E2640);margin-top:14px;}.cp-pearl b{color:var(--rn-text,#1E2640);}.cp-sysgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(255px,1fr));gap:11px;}.cp-sys{border:1px solid var(--rn-border,#E2E6F0);border-left:4px solid;border-radius:11px;padding:12px 14px;background:var(--rn-card,#fff);}.cp-sys.tier-red{border-left-color:var(--rn-red,#C93535);}.cp-sys.tier-amber{border-left-color:var(--rn-amber,#B86B00);}.cp-sys.tier-green{border-left-color:var(--rn-green,#1F8B5E);}.cp-sys-h{font-family:var(--mono,'SF Mono',SFMono-Regular,ui-monospace,Menlo,Consolas,monospace);font-size:11px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--rn-text,#1E2640);margin-bottom:9px;}.cp-sys-dx{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px;}.cp-sys-d{font-size:12px;line-height:1.45;color:var(--rn-sub,#5A6480);}.cp-dx{display:inline-block;font-size:12.5px;font-weight:600;text-decoration:none;padding:3px 10px;border-radius:999px;background:var(--rn-blue-bg,#EBF2FF);color:var(--rn-blue,#3B7DD8);border:1px solid transparent;transition:all .13s;}.cp-dx:hover{border-color:var(--rn-blue,#3B7DD8);}.cp-dx-off{background:#F1F3F8;color:var(--rn-sub,#7A8396);}.cp-hand{display:flex;gap:10px;background:var(--rn-blue-bg,#EBF2FF);border:1.5px solid #B0CCEF;border-radius:10px;padding:14px 18px;font-size:13.5px;line-height:1.7;color:var(--rn-text,#1E2640);margin-top:26px;}.cp-hand b{color:var(--rn-blue,#3B7DD8);}.cp-mapic{font-size:18px;line-height:1;}.cp-flow{display:flex;flex-direction:column;align-items:center;text-align:center;}.cp-dn{color:var(--rn-border,#C7CEDB);font-size:13px;line-height:1;margin:5px 0;}.cp-node{border-radius:11px;padding:10px 18px;font-weight:700;font-size:13.5px;max-width:560px;background:var(--rn-card,#fff);border:1.5px solid var(--rn-border,#E2E6F0);color:var(--rn-text,#1E2640);}.cp-node.start{background:var(--rn-blue-bg,#EBF2FF);border-color:#B0CCEF;color:var(--rn-blue,#3B7DD8);font-weight:800;letter-spacing:.06em;}.cp-node.danger{background:var(--rn-red-bg,#FDEAEA);border-color:#EDBFBF;color:var(--rn-red,#C93535);}.cp-node-sub{font-weight:500;font-size:10.5px;margin-top:3px;opacity:.9;}.cp-flowlabel{font-size:11px;color:var(--rn-muted,#9AA4B2);font-style:italic;margin:6px 0;}.cp-node.decision{background:var(--rn-amber-bg,#FEF5E4);border-color:#E8CE93;color:var(--rn-amber,#B86B00);}.cp-node.work{background:var(--rn-blue-bg,#EBF2FF);border-color:#B0CCEF;color:var(--rn-blue,#3B7DD8);font-weight:800;}.cp-node.final{background:var(--rn-blue-bg,#EBF2FF);border-color:#B7CEF0;color:var(--rn-blue,#3B7DD8);}.cp-branchbox{width:100%;border:1.5px dashed var(--rn-border,#D8DEEA);border-radius:14px;padding:14px 12px;background:transparent;}.cp-branchcols{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;}.cp-col{display:flex;flex-direction:column;align-items:center;flex:1 1 128px;max-width:150px;}.cp-feat{font-size:11px;font-weight:600;background:#F1F3F8;border:1px solid var(--rn-border,#E2E6F0);border-radius:8px;padding:6px 8px;width:100%;min-height:42px;display:flex;align-items:center;justify-content:center;color:var(--rn-sub,#5A6480);}.cp-cdn{color:var(--rn-border,#C7CEDB);font-size:10px;margin:3px 0;}.cp-dx-node{font-size:12px;font-weight:800;border-radius:8px;padding:7px 8px;width:100%;border:1px solid;text-decoration:none;}.cp-dx-node.tier-red{background:var(--rn-red-bg,#FDEAEA);border-color:#EDC6C6;color:var(--rn-red,#C93535);}.cp-dx-node.tier-amber{background:var(--rn-amber-bg,#FEF5E4);border-color:#EAD4A4;color:var(--rn-amber,#B86B00);}.cp-dx-node.tier-green{background:var(--rn-green-bg,#E6F6EF);border-color:#B9E2CD;color:var(--rn-green,#1F8B5E);}.cp-test{font-size:10.5px;color:var(--rn-sub,#7A8396);font-weight:600;margin-top:5px;}.cp-dxlink{display:block;text-decoration:none;cursor:pointer;}.cp-dxlink:hover{box-shadow:0 0 0 2px currentColor inset;}</style><div class=\"cp-lead\"><b>Genital discharge splits first by sex and site.</b> In <b>men</b>, a urethral discharge is <b>urethritis</b>: <b>profuse and purulent</b> suggests <b>gonorrhoea</b>, while <b>scant and mucoid</b> suggests <b>non-gonococcal urethritis</b> (usually chlamydia) (see <a class=\"cp-dx\" href=\"#conditions/SEXUAL%20HEALTH/Gonorrhoea\">gonorrhoea</a>, <a class=\"cp-dx\" href=\"#conditions/SEXUAL%20HEALTH/Chlamydia\">chlamydia</a>, <a class=\"cp-dx\" href=\"#conditions/SEXUAL%20HEALTH/Urethritis%20%28NGU%29\">urethritis (NGU)</a>). In <b>women</b>, most discharge is <b>physiological or non-sexually-transmitted</b>: <b>thick, white, &ldquo;cottage-cheese&rdquo;</b> with itch is <b>candida</b>; <b>thin, grey, fishy-smelling</b> is <b>bacterial vaginosis</b>; <b>frothy, yellow-green</b> with itch is <b>trichomonas</b> (see <a class=\"cp-dx\" href=\"#conditions/SEXUAL%20HEALTH/Candidiasis%20%28genital%29\">candidiasis</a>, <a class=\"cp-dx\" href=\"#conditions/SEXUAL%20HEALTH/Bacterial%20Vaginosis%20%28SH%20framing%29\">bacterial vaginosis</a>). A <b>mucopurulent discharge from the cervix</b> with <b>post-coital bleeding</b> is <b>cervicitis</b> (chlamydia / gonorrhoea). The key escalation is <b>ascending infection</b>: deep pain, fever and cervical excitation mean <b>pelvic inflammatory disease</b> (see <a class=\"cp-dx\" href=\"#conditions/SEXUAL%20HEALTH/PID%20%28SH%20framing%29\">pelvic inflammatory disease</a>). Whatever the cause, take a <b>full sexual-health screen</b> and arrange <b>partner notification</b>.</div><div class=\"cp-warn\"><span class=\"cp-warn-ic\">🚨</span><span><b>Do not miss the ascending and the systemic.</b> <b>Pelvic inflammatory disease</b> &mdash; deep pelvic pain, deep dyspareunia, <b>fever</b> and <b>cervical motion tenderness</b> &mdash; threatens <b>fertility</b> (tubal damage, ectopic risk) and is treated <b>empirically</b> without waiting for swabs (see <a class=\"cp-dx\" href=\"#conditions/SEXUAL%20HEALTH/PID%20%28SH%20framing%29\">pelvic inflammatory disease</a>). <b>Gonorrhoea</b> is increasingly <b>antibiotic-resistant</b> (always <b>culture</b>) and can <b>disseminate</b> (arthritis, pustular rash) (see <a class=\"cp-dx\" href=\"#conditions/SEXUAL%20HEALTH/Gonorrhoea\">gonorrhoea</a>). A pregnant woman with discharge and pain needs an <b>ectopic pregnancy</b> excluded, and a <b>neonate with purulent conjunctivitis</b> (ophthalmia neonatorum) needs urgent treatment for gonococcal / chlamydial infection. Always take a full <b>STI screen (HIV, syphilis)</b>, consider a <b>retained tampon / foreign body</b>, and remember <b>safeguarding</b> in the young or vulnerable.</span></div><div style=\"font-size:22px;\"><div style=\"font-size:22px;\">📷</div><div style=\"font-size:12.5px;font-weight:700;\">Image placeholder &mdash; genital discharge: male urethral (purulent = gonorrhoea, mucoid = NGU/chlamydia) vs female vaginal (white + itch = candida, grey + fishy = BV, green frothy = trichomonas, mucopurulent cervix = cervicitis); red flag = PID (deep pain, fever, cervical excitation)</div><div style=\"font-family:var(--mono);font-size:10.5px;text-transform:uppercase;letter-spacing:.05em;color:var(--rn-muted,#9AA4B2);margin-top:10px;\">link to be uploaded</div></div><div class=\"cp-step\" id=\"s-1\"><div class=\"cp-step-h\"><span class=\"cp-num\">1</span><span class=\"cp-title\">Confirm &amp; classify</span></div><div class=\"cp-step-body\"><div class=\"cp-killgrid\"><div class=\"cp-kill\" style=\"--kc:var(--rn-red,#C93535);--kcb:var(--rn-red-bg,#FDEAEA);\"><div class=\"cp-kill-top\"><span class=\"cp-kill-ic\">🚩</span><span class=\"cp-kill-name\">Pelvic inflammatory disease</span></div><div class=\"cp-kill-desc\"><ul style=\"margin:6px 0 0;padding-left:17px;list-style:disc;\"><li style=\"margin:3px 0;\"><b>Deep pelvic pain, deep dyspareunia, fever</b> and <b>cervical motion tenderness</b>; mucopurulent cervix</li><li style=\"margin:3px 0;\">Ascending chlamydia / gonorrhoea &rarr; <b>tubal damage, infertility, ectopic risk</b> (see <a class=\"cp-dx\" href=\"#conditions/SEXUAL%20HEALTH/PID%20%28SH%20framing%29\">pelvic inflammatory disease</a>)</li><li style=\"margin:3px 0;\"><b>Treat empirically</b> &mdash; do not wait for swab results</li></ul></div></div><div class=\"cp-kill\" style=\"--kc:var(--rn-amber,#B86B00);--kcb:var(--rn-amber-bg,#FEF5E4);\"><div class=\"cp-kill-top\"><span class=\"cp-kill-ic\">🟠</span><span class=\"cp-kill-name\">Gonorrhoea</span></div><div class=\"cp-kill-desc\"><ul style=\"margin:6px 0 0;padding-left:17px;list-style:disc;\"><li style=\"margin:3px 0;\"><b>Profuse, purulent</b> urethral or cervical discharge + dysuria; may be <b>asymptomatic</b> in women</li><li style=\"margin:3px 0;\">Increasingly <b>antibiotic-resistant</b> &mdash; always <b>culture</b> (not just NAAT) (see <a class=\"cp-dx\" href=\"#conditions/SEXUAL%20HEALTH/Gonorrhoea\">gonorrhoea</a>)</li><li style=\"margin:3px 0;\">Can <b>disseminate</b>: arthritis, tenosynovitis, pustular rash; causes ophthalmia neonatorum</li></ul></div></div><div class=\"cp-kill\" style=\"--kc:var(--rn-amber,#B86B00);--kcb:var(--rn-amber-bg,#FEF5E4);\"><div class=\"cp-kill-top\"><span class=\"cp-kill-ic\">🟠</span><span class=\"cp-kill-name\">Chlamydia / NGU</span></div><div class=\"cp-kill-desc\"><ul style=\"margin:6px 0 0;padding-left:17px;list-style:disc;\"><li style=\"margin:3px 0;\"><b>Scant, mucoid</b> urethral discharge; the <b>commonest</b> STI &mdash; often <b>asymptomatic</b></li><li style=\"margin:3px 0;\">Non-gonococcal urethritis (chlamydia, <i>Mycoplasma genitalium</i>) (see <a class=\"cp-dx\" href=\"#conditions/SEXUAL%20HEALTH/Chlamydia\">chlamydia</a>, <a class=\"cp-dx\" href=\"#conditions/SEXUAL%20HEALTH/Urethritis%20%28NGU%29\">urethritis (NGU)</a>)</li><li style=\"margin:3px 0;\">Complications: PID, epididymo-orchitis, reactive arthritis, tubal infertility</li></ul></div></div><div class=\"cp-kill\" style=\"--kc:var(--rn-blue,#3B7DD8);--kcb:var(--rn-blue-bg,#EBF2FF);\"><div class=\"cp-kill-top\"><span class=\"cp-kill-ic\">🍶</span><span class=\"cp-kill-name\">Candidiasis</span></div><div class=\"cp-kill-desc\"><ul style=\"margin:6px 0 0;padding-left:17px;list-style:disc;\"><li style=\"margin:3px 0;\"><b>Thick, white, &ldquo;cottage-cheese&rdquo;</b> discharge + <b>vulval itch</b> and soreness; <b>no offensive odour</b></li><li style=\"margin:3px 0;\"><b>Not</b> sexually transmitted; commoner in diabetes, pregnancy, after antibiotics (see <a class=\"cp-dx\" href=\"#conditions/SEXUAL%20HEALTH/Candidiasis%20%28genital%29\">candidiasis</a>)</li><li style=\"margin:3px 0;\">Vulval erythema / fissuring; diagnosis is largely clinical</li></ul></div></div><div class=\"cp-kill\" style=\"--kc:var(--rn-blue,#3B7DD8);--kcb:var(--rn-blue-bg,#EBF2FF);\"><div class=\"cp-kill-top\"><span class=\"cp-kill-ic\">🐟</span><span class=\"cp-kill-name\">Bacterial vaginosis</span></div><div class=\"cp-kill-desc\"><ul style=\"margin:6px 0 0;padding-left:17px;list-style:disc;\"><li style=\"margin:3px 0;\"><b>Thin, grey-white, homogeneous</b> discharge with a <b>fishy odour</b>; <b>little itch</b> or inflammation</li><li style=\"margin:3px 0;\">Overgrowth of anaerobes (loss of lactobacilli); <b>not</b> an STI (see <a class=\"cp-dx\" href=\"#conditions/SEXUAL%20HEALTH/Bacterial%20Vaginosis%20%28SH%20framing%29\">bacterial vaginosis</a>)</li><li style=\"margin:3px 0;\">Raised vaginal <b>pH &gt;4.5</b>, <b>clue cells</b>; associated with preterm birth in pregnancy</li></ul></div></div><div class=\"cp-kill\" style=\"--kc:var(--rn-blue,#3B7DD8);--kcb:var(--rn-blue-bg,#EBF2FF);\"><div class=\"cp-kill-top\"><span class=\"cp-kill-ic\">🦠</span><span class=\"cp-kill-name\">Trichomonas &amp; other</span></div><div class=\"cp-kill-desc\"><ul style=\"margin:6px 0 0;padding-left:17px;list-style:disc;\"><li style=\"margin:3px 0;\"><b>Frothy, yellow-green</b>, offensive discharge + itch; <b>&ldquo;strawberry cervix&rdquo;</b> (trichomonas &mdash; an STI)</li><li style=\"margin:3px 0;\"><b>Cervicitis</b>: mucopurulent cervical discharge + post-coital bleeding (chlamydia / gonorrhoea)</li><li style=\"margin:3px 0;\">Consider a <b>retained tampon / foreign body</b>, and physiological discharge (see <a class=\"cp-dx\" href=\"#signs/RENAL%20%2F%20UROLOGICAL/Dysuria\">dysuria</a>)</li></ul></div></div></div><div class=\"cp-pearl\"><b>Sex, site, and the character of the discharge.</b> In <b>men</b>, <b>purulent = gonorrhoea</b> and <b>mucoid = chlamydia/NGU</b>. In <b>women</b>, <b>white + itch = candida</b>, <b>grey + fishy = BV</b>, <b>green + frothy = trichomonas</b>. Layer on <b>deep pain + fever + cervical excitation</b> and you have <b>PID</b> &mdash; treat empirically.</div></div></div><div class=\"cp-step\" id=\"s-2\"><div class=\"cp-step-h\"><span class=\"cp-num\">2</span><span class=\"cp-title\">What it points to</span></div><div class=\"cp-step-body\"><div class=\"cp-clues\"><div class=\"cp-clue\"><div class=\"cp-when\"><b>Man: profuse purulent urethral discharge + dysuria</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/SEXUAL%20HEALTH/Gonorrhoea\">Gonorrhoea</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Man: scant mucoid discharge, or asymptomatic</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/SEXUAL%20HEALTH/Chlamydia\">Chlamydia / NGU</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Woman: thick white cottage-cheese discharge + itch, no odour</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/SEXUAL%20HEALTH/Candidiasis%20%28genital%29\">Candidiasis</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Woman: thin grey discharge + fishy odour, little itch</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/SEXUAL%20HEALTH/Bacterial%20Vaginosis%20%28SH%20framing%29\">Bacterial vaginosis</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Woman: frothy yellow-green offensive discharge + strawberry cervix</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/SEXUAL%20HEALTH/Gonorrhoea\">Trichomoniasis (do full STI screen)</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Mucopurulent cervical discharge + post-coital bleeding</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/SEXUAL%20HEALTH/Chlamydia\">Cervicitis (chlamydia / gonorrhoea)</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Deep pelvic pain + fever + cervical motion tenderness</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/SEXUAL%20HEALTH/PID%20%28SH%20framing%29\">Pelvic inflammatory disease</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Offensive discharge with a retained tampon / foreign body</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><span class=\"cp-dx cp-dx-off\">Foreign body (remove &amp; treat)</span></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Neonate with purulent conjunctivitis in the first weeks</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/SEXUAL%20HEALTH/Gonorrhoea\">Ophthalmia neonatorum</a></div></div></div><div class=\"cp-pearl\"><b>Colour and smell narrow it fast.</b> <b>Purulent</b> urethral discharge is gonorrhoea; <b>cottage-cheese</b> is candida; <b>fishy grey</b> is BV; <b>green and frothy</b> is trichomonas. But swabs and a <b>full STI screen</b> are mandatory &mdash; co-infection is common and much is <b>asymptomatic</b>.</div></div></div><div class=\"cp-step\" id=\"s-3\"><div class=\"cp-step-h\"><span class=\"cp-num\">3</span><span class=\"cp-title\">Assess &amp; act</span></div><div class=\"cp-step-body\"><div class=\"cp-sub\">At the bedside &mdash; character of the discharge, examine, and screen fully</div><div class=\"cp-bed\"><div class=\"cp-bed-h\"><span class=\"cp-bed-n\">History &amp; red flags</span></div><div class=\"cp-reads\"><span class=\"cp-read\"><b>Colour / consistency / odour</b>, itch, <b>dysuria</b>, <b>deep pelvic pain / dyspareunia</b>, fever, inter-menstrual / post-coital bleeding, a <b>full sexual history</b> (partners, sites, condom use), pregnancy, and <b>safeguarding</b> concerns</span></div></div><div class=\"cp-bed cp-bed-hot\"><div class=\"cp-bed-h\"><span class=\"cp-bed-n\">Examine</span></div><div class=\"cp-reads\"><span class=\"cp-read\">Inspect the <b>discharge and genital skin</b>; in women a <b>speculum</b> (cervix, os discharge, contact bleeding) and <b>bimanual</b> for <b>cervical excitation</b> and adnexal tenderness; in men the <b>urethral meatus</b>; check for a <b>foreign body</b> and examine joints / skin if disseminated infection is suspected</span></div></div><div class=\"cp-bed\"><div class=\"cp-bed-h\"><span class=\"cp-bed-n\">Investigate</span></div><div class=\"cp-reads\"><span class=\"cp-read\"><b>NAAT</b> for chlamydia &amp; gonorrhoea (<b>first-pass urine</b> in men, <b>vulvovaginal swab</b> in women) plus <b>gonococcal culture</b> (resistance); vaginal <b>pH</b>, microscopy / wet-mount (clue cells, hyphae, motile trichomonads); a <b>full STI screen (HIV, syphilis)</b>; pregnancy test; urine dip for UTI overlap</span></div></div><div class=\"cp-bed\"><div class=\"cp-bed-h\"><span class=\"cp-bed-n\">Act</span></div><div class=\"cp-reads\"><span class=\"cp-read\">Treat by cause: <b>ceftriaxone</b> for gonorrhoea, <b>doxycycline</b> for chlamydia/NGU, <b>metronidazole</b> for BV / trichomonas, topical / oral <b>antifungal</b> for candida; <b>empirical antibiotics</b> for PID. Always arrange <b>partner notification</b>, offer screening for other STIs, and give safety-net / abstinence advice</span></div></div><div class=\"cp-sub\">Then &mdash; confirm the cause</div><div class=\"cp-confirm\"><span class=\"cp-cfm\"><span class=\"cp-dxn\">Gonorrhoea</span> <span class=\"cp-ar\">&rarr;</span> <span class=\"cp-tst\"><b>NAAT + culture</b> (resistance)</span></span><span class=\"cp-cfm\"><span class=\"cp-dxn\">Chlamydia / NGU</span> <span class=\"cp-ar\">&rarr;</span> <span class=\"cp-tst\"><b>NAAT</b></span></span><span class=\"cp-cfm\"><span class=\"cp-dxn\">Candidiasis</span> <span class=\"cp-ar\">&rarr;</span> <span class=\"cp-tst\"><b>microscopy</b> (hyphae / spores) / clinical</span></span><span class=\"cp-cfm\"><span class=\"cp-dxn\">Bacterial vaginosis</span> <span class=\"cp-ar\">&rarr;</span> <span class=\"cp-tst\"><b>pH &gt;4.5 + clue cells</b> (Amsel)</span></span><span class=\"cp-cfm\"><span class=\"cp-dxn\">Trichomoniasis</span> <span class=\"cp-ar\">&rarr;</span> <span class=\"cp-tst\"><b>NAAT / wet-mount</b> (motile)</span></span><span class=\"cp-cfm\"><span class=\"cp-dxn\">PID</span> <span class=\"cp-ar\">&rarr;</span> <span class=\"cp-tst\"><b>clinical + swabs</b> (treat empirically)</span></span></div><div class=\"cp-pearl\"><b>The rules that carry it:</b> split by <b>sex and site</b>, read the <b>colour and smell</b>, but always take a <b>NAAT + full STI screen</b> because co-infection and asymptomatic carriage are common. Treat <b>PID empirically</b> to protect fertility, <b>culture</b> gonorrhoea, and never forget <b>partner notification</b>.</div></div></div><div class=\"cp-hand\" id=\"s-hand\"><span>➡️</span><span>Landed on a diagnosis? Open its <b>note</b> for investigations, management &amp; prognosis &mdash; every blue link above jumps straight there. <b>This is where the conditions library takes over.</b></span></div><div class=\"cp-step\" id=\"s-map\"><div class=\"cp-step-h\"><span class=\"cp-mapic\">🗺️</span><span class=\"cp-title\">In summary</span></div><div class=\"cp-step-body\"><div class=\"cp-flow\"><div class=\"cp-node start\">GENITAL DISCHARGE &mdash; male urethral or female vaginal?</div><div class=\"cp-dn\">▼</div><div class=\"cp-node danger\">PID (deep pain + fever + cervical excitation &rarr; fertility) &middot; resistant / disseminated gonorrhoea &middot; ophthalmia neonatorum &middot; always full STI screen + partner notification</div><div class=\"cp-dn\">▼</div><div class=\"cp-node decision\">Male: purulent = gonorrhoea &middot; scant mucoid = chlamydia / NGU &rarr; NAAT (first-pass urine) + culture</div><div class=\"cp-dn\">▼</div><div class=\"cp-node decision\">Female: white + itch = candida &middot; grey + fishy = BV &middot; green frothy = trichomonas &middot; mucopurulent cervix = cervicitis</div><div class=\"cp-dn\">▼</div><div class=\"cp-branchbox\"><div class=\"cp-branchcols\"><div class=\"cp-col\"><div class=\"cp-feat\">Deep pain + fever + cervical excitation</div><div class=\"cp-cdn\">▼</div><a href=\"#conditions/SEXUAL%20HEALTH/PID%20%28SH%20framing%29\" class=\"cp-dx-node tier-red cp-dxlink\">Pelvic inflammatory disease</a><div class=\"cp-cdn\">▼</div><div class=\"cp-test\">treat empirically</div></div><div class=\"cp-col\"><div class=\"cp-feat\">Profuse purulent urethral / cervical</div><div class=\"cp-cdn\">▼</div><a href=\"#conditions/SEXUAL%20HEALTH/Gonorrhoea\" class=\"cp-dx-node tier-amber cp-dxlink\">Gonorrhoea</a><div class=\"cp-cdn\">▼</div><div class=\"cp-test\">NAAT + culture</div></div><div class=\"cp-col\"><div class=\"cp-feat\">Scant mucoid / asymptomatic</div><div class=\"cp-cdn\">▼</div><a href=\"#conditions/SEXUAL%20HEALTH/Chlamydia\" class=\"cp-dx-node tier-amber cp-dxlink\">Chlamydia / NGU</a><div class=\"cp-cdn\">▼</div><div class=\"cp-test\">NAAT</div></div><div class=\"cp-col\"><div class=\"cp-feat\">Thick white + itch, no odour</div><div class=\"cp-cdn\">▼</div><a href=\"#conditions/SEXUAL%20HEALTH/Candidiasis%20%28genital%29\" class=\"cp-dx-node tier-green cp-dxlink\">Candidiasis</a><div class=\"cp-cdn\">▼</div><div class=\"cp-test\">microscopy</div></div><div class=\"cp-col\"><div class=\"cp-feat\">Thin grey + fishy odour</div><div class=\"cp-cdn\">▼</div><a href=\"#conditions/SEXUAL%20HEALTH/Bacterial%20Vaginosis%20%28SH%20framing%29\" class=\"cp-dx-node tier-green cp-dxlink\">Bacterial vaginosis</a><div class=\"cp-cdn\">▼</div><div class=\"cp-test\">pH + clue cells</div></div></div></div><div class=\"cp-dn\">▼</div><div class=\"cp-node work\">NAAT (urine / vulvovaginal swab) + gonococcal culture &middot; vaginal pH + microscopy &middot; full STI screen (HIV, syphilis) + pregnancy test</div><div class=\"cp-dn\">▼</div><div class=\"cp-node final\">➡️ Open the condition note &mdash; ceftriaxone / doxycycline / metronidazole / antifungal &middot; empirical PID treatment &middot; partner notification</div></div></div></div></div>"}