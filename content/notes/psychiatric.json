{"PSYCHIATRIC__Low Mood": "<div class=\"cp\"><div class=\"cp\"><style>.cp *{box-sizing:border-box;}.cp{font-family:var(--sans,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif);color:var(--rn-text,#1E2640);line-height:1.5;}.cp-lead{font-size:14px;line-height:1.75;color:var(--rn-sub,#5A6480);margin:2px 0 14px;background:var(--rn-card,#fff);border:1.5px solid var(--rn-border,#E2E6F0);border-radius:12px;padding:16px 18px;box-shadow:0 1px 4px rgba(0,0,0,.05);}.cp-lead b{color:var(--rn-text,#1E2640);}.cp-warn{display:flex;gap:10px;background:var(--rn-red-bg,#FDEAEA);border:1.5px solid #F2BABA;color:var(--rn-text,#1E2640);border-radius:10px;padding:14px 18px;font-size:13.5px;line-height:1.7;margin-bottom:12px;}.cp-warn b{color:var(--rn-red,#C93535);}.cp-warn .cp-warn-ic{font-size:16px;line-height:1.4;}.cp-step{margin-bottom:12px;background:var(--rn-card,#fff);border:1.5px solid var(--rn-border,#E2E6F0);border-radius:12px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.05);}.cp-step-h{display:flex;align-items:center;gap:11px;padding:12px 20px;border-bottom:1.5px solid var(--rn-border,#E2E6F0);background:var(--rn-blue-bg,#EBF2FF);}.cp-step-body{padding:20px;}.cp-step-body>.cp-sub:first-child{margin-top:0;}.cp-num{flex:none;width:24px;height:24px;border-radius:50%;background:var(--rn-blue,#3B7DD8);color:#fff;font-size:13px;font-weight:800;display:flex;align-items:center;justify-content:center;font-family:var(--mono,'SF Mono',SFMono-Regular,ui-monospace,Menlo,Consolas,monospace);}.cp-title{font-family:var(--mono,'SF Mono',SFMono-Regular,ui-monospace,Menlo,Consolas,monospace);font-size:12px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--rn-blue,#3B7DD8);}.cp-killgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(215px,1fr));gap:11px;}.cp-kill{border:1px solid var(--rn-border,#E2E6F0);border-left:4px solid var(--kc,var(--rn-blue,#3B7DD8));border-radius:11px;padding:0;overflow:hidden;background:var(--rn-card,#fff);}.cp-kill-top{display:flex;align-items:center;gap:8px;padding:9px 13px;background:var(--kcb,var(--rn-blue-bg,#EBF2FF));border-bottom:1px solid var(--rn-border,#E2E6F0);}.cp-kill-ic{font-size:15px;}.cp-kill-name{font-size:14px;font-weight:800;color:var(--kc,var(--rn-text,#1E2640));}.cp-kill-desc{padding:11px 13px;font-size:12.5px;line-height:1.5;color:var(--rn-sub,#5A6480);}.cp-kill .cp-dx{margin-top:9px;}.cp-clue{display:flex;align-items:center;gap:12px;padding:11px 2px;border-bottom:1px solid var(--rn-border,#EEF1F7);}.cp-clue:last-child{border-bottom:none;}.cp-when{flex:1 1 44%;font-size:13.5px;font-weight:700;color:var(--rn-text,#1E2640);}.cp-arrow{flex:none;color:var(--rn-blue,#3B7DD8);font-weight:700;}.cp-then{flex:1 1 52%;display:flex;flex-wrap:wrap;gap:6px;}.cp-bed{padding:12px 14px;border-radius:10px;background:#F1F3F8;border:1.5px solid var(--rn-border,#E2E6F0);margin-bottom:8px;}.cp-bed-hot{background:var(--rn-red-bg,#FDEAEA);border-color:#F2BABA;}.cp-bed-h{display:flex;align-items:baseline;gap:8px;margin-bottom:7px;}.cp-bed-n{font-family:var(--mono,'SF Mono',SFMono-Regular,ui-monospace,Menlo,Consolas,monospace);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--rn-text,#1E2640);}.cp-bed-hot .cp-bed-n{color:var(--rn-red,#C93535);}.cp-bed-when{font-size:11px;color:var(--rn-muted,#9AA4B2);font-style:italic;}.cp-reads{display:flex;flex-wrap:wrap;gap:6px;}.cp-read{font-size:11.5px;line-height:1.35;background:var(--rn-card,#fff);border:1px solid var(--rn-border,#E2E6F0);border-radius:7px;padding:4px 9px;color:var(--rn-sub,#5A6480);}.cp-read b{color:var(--rn-text,#1E2640);font-weight:700;}.cp-read .cp-ar{color:var(--rn-blue,#3B7DD8);}.cp-bed-hot .cp-read{border-color:#F3B7B7;}.cp-sub{font-family:var(--mono,'SF Mono',SFMono-Regular,ui-monospace,Menlo,Consolas,monospace);font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--rn-text,#1E2640);margin:16px 0 10px;}.cp-confirm{display:flex;flex-wrap:wrap;gap:7px;}.cp-cfm{font-size:12px;line-height:1.4;background:var(--rn-blue-bg,#EBF2FF);border:1px solid #D6E4FA;border-radius:8px;padding:5px 10px;}.cp-cfm .cp-dxn{font-weight:800;color:var(--rn-text,#1E2640);}.cp-cfm .cp-ar{color:var(--rn-blue,#3B7DD8);}.cp-cfm .cp-tst{color:var(--rn-blue,#3B7DD8);font-weight:600;}.cp-pearl{background:var(--rn-yellow-bg,#FFFBE6);border:1.5px solid #E8D48A;border-left:4px solid var(--rn-yellow,#8A6C00);border-radius:0 10px 10px 0;padding:12px 16px;font-size:13.5px;line-height:1.6;color:var(--rn-text,#1E2640);margin-top:14px;}.cp-pearl b{color:var(--rn-text,#1E2640);}.cp-sysgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(255px,1fr));gap:11px;}.cp-sys{border:1px solid var(--rn-border,#E2E6F0);border-left:4px solid;border-radius:11px;padding:12px 14px;background:var(--rn-card,#fff);}.cp-sys.tier-red{border-left-color:var(--rn-red,#C93535);}.cp-sys.tier-amber{border-left-color:var(--rn-amber,#B86B00);}.cp-sys.tier-green{border-left-color:var(--rn-green,#1F8B5E);}.cp-sys-h{font-family:var(--mono,'SF Mono',SFMono-Regular,ui-monospace,Menlo,Consolas,monospace);font-size:11px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--rn-text,#1E2640);margin-bottom:9px;}.cp-sys-dx{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px;}.cp-sys-d{font-size:12px;line-height:1.45;color:var(--rn-sub,#5A6480);}.cp-dx{display:inline-block;font-size:12.5px;font-weight:600;text-decoration:none;padding:3px 10px;border-radius:999px;background:var(--rn-blue-bg,#EBF2FF);color:var(--rn-blue,#3B7DD8);border:1px solid transparent;transition:all .13s;}.cp-dx:hover{border-color:var(--rn-blue,#3B7DD8);}.cp-dx-off{background:#F1F3F8;color:var(--rn-sub,#7A8396);}.cp-hand{display:flex;gap:10px;background:var(--rn-blue-bg,#EBF2FF);border:1.5px solid #B0CCEF;border-radius:10px;padding:14px 18px;font-size:13.5px;line-height:1.7;color:var(--rn-text,#1E2640);margin-top:26px;}.cp-hand b{color:var(--rn-blue,#3B7DD8);}.cp-mapic{font-size:18px;line-height:1;}.cp-flow{display:flex;flex-direction:column;align-items:center;text-align:center;}.cp-dn{color:var(--rn-border,#C7CEDB);font-size:13px;line-height:1;margin:5px 0;}.cp-node{border-radius:11px;padding:10px 18px;font-weight:700;font-size:13.5px;max-width:560px;background:var(--rn-card,#fff);border:1.5px solid var(--rn-border,#E2E6F0);color:var(--rn-text,#1E2640);}.cp-node.start{background:var(--rn-blue-bg,#EBF2FF);border-color:#B0CCEF;color:var(--rn-blue,#3B7DD8);font-weight:800;letter-spacing:.06em;}.cp-node.danger{background:var(--rn-red-bg,#FDEAEA);border-color:#EDBFBF;color:var(--rn-red,#C93535);}.cp-node-sub{font-weight:500;font-size:10.5px;margin-top:3px;opacity:.9;}.cp-flowlabel{font-size:11px;color:var(--rn-muted,#9AA4B2);font-style:italic;margin:6px 0;}.cp-node.decision{background:var(--rn-amber-bg,#FEF5E4);border-color:#E8CE93;color:var(--rn-amber,#B86B00);}.cp-node.work{background:var(--rn-blue-bg,#EBF2FF);border-color:#B0CCEF;color:var(--rn-blue,#3B7DD8);font-weight:800;}.cp-node.final{background:var(--rn-blue-bg,#EBF2FF);border-color:#B7CEF0;color:var(--rn-blue,#3B7DD8);}.cp-branchbox{width:100%;border:1.5px dashed var(--rn-border,#D8DEEA);border-radius:14px;padding:14px 12px;background:transparent;}.cp-branchcols{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;}.cp-col{display:flex;flex-direction:column;align-items:center;flex:1 1 128px;max-width:150px;}.cp-feat{font-size:11px;font-weight:600;background:#F1F3F8;border:1px solid var(--rn-border,#E2E6F0);border-radius:8px;padding:6px 8px;width:100%;min-height:42px;display:flex;align-items:center;justify-content:center;color:var(--rn-sub,#5A6480);}.cp-cdn{color:var(--rn-border,#C7CEDB);font-size:10px;margin:3px 0;}.cp-dx-node{font-size:12px;font-weight:800;border-radius:8px;padding:7px 8px;width:100%;border:1px solid;text-decoration:none;}.cp-dx-node.tier-red{background:var(--rn-red-bg,#FDEAEA);border-color:#EDC6C6;color:var(--rn-red,#C93535);}.cp-dx-node.tier-amber{background:var(--rn-amber-bg,#FEF5E4);border-color:#EAD4A4;color:var(--rn-amber,#B86B00);}.cp-dx-node.tier-green{background:var(--rn-green-bg,#E6F6EF);border-color:#B9E2CD;color:var(--rn-green,#1F8B5E);}.cp-test{font-size:10.5px;color:var(--rn-sub,#7A8396);font-weight:600;margin-top:5px;}.cp-dxlink{display:block;text-decoration:none;cursor:pointer;}.cp-dxlink:hover{box-shadow:0 0 0 2px currentColor inset;}</style><div class=\"cp-lead\"><b>Low mood is a symptom, and the first move is always to assess risk.</b> Before anything else, ask directly about <b>suicidal thoughts, plans, intent and means</b> &mdash; a positive answer changes the plan immediately (see <a class=\"cp-dx\" href=\"#signs/PSYCHIATRIC/Self-Harm%20%26%20Suicidal%20Ideation\">self-harm &amp; suicidal ideation</a>). Then decide: is this <b>clinical depression</b>, and is it <b>unipolar or bipolar</b>? Core <b>depression</b> is persistent <b>low mood, anhedonia and low energy for &ge;2 weeks</b> with cognitive and biological symptoms (see <a class=\"cp-dx\" href=\"#conditions/PSYCHIATRY/Depressive%20Disorders\">depressive disorders</a>). Always ask about <b>past mania / hypomania</b> &mdash; <b>bipolar depression</b> must not be treated with antidepressant monotherapy (see <a class=\"cp-dx\" href=\"#conditions/PSYCHIATRY/Bipolar%20Affective%20Disorder\">bipolar disorder</a>, <a class=\"cp-dx\" href=\"#signs/PSYCHIATRIC/Mania\">mania</a>). And <b>exclude organic causes</b>: <b>hypothyroidism, anaemia / B12 deficiency, drugs</b> (steroids, beta-blockers, <b>alcohol</b>), Cushing&rsquo;s, Parkinson&rsquo;s, dementia and occult malignancy (see <a class=\"cp-dx\" href=\"#conditions/ENDOCRINOLOGY/Hypothyroidism\">hypothyroidism</a>, <a class=\"cp-dx\" href=\"#conditions/HAEMATOLOGY/Anaemia%20%28micro%2Fnormo%2Fmacrocytic%29\">anaemia</a>, <a class=\"cp-dx\" href=\"#conditions/PSYCHIATRY/Substance%20Use%20Disorder\">substance use</a>). Don&rsquo;t forget <b>bereavement</b> and <b>adjustment</b>, and comorbid <b>anxiety</b>.</div><div class=\"cp-warn\"><span class=\"cp-warn-ic\">🚨</span><span><b>Assess suicide risk in everyone with low mood.</b> Ask about <b>ideation, plans, intent, means, and protective factors</b>; escalate for a specific plan, intent, access to means, previous attempts, or command hallucinations (see <a class=\"cp-dx\" href=\"#signs/PSYCHIATRIC/Self-Harm%20%26%20Suicidal%20Ideation\">self-harm &amp; suicidal ideation</a>, <a class=\"cp-dx\" href=\"#conditions/PSYCHIATRY/Self-Harm%20%26%20Suicide%20Risk\">self-harm &amp; suicide risk</a>). <b>Severe / psychotic depression</b> &mdash; <b>delusions of guilt, poverty or nihilism (Cotard&rsquo;s), catatonia, or severe self-neglect and dehydration</b> &mdash; is a psychiatric emergency needing urgent assessment (&plusmn; ECT) (see <a class=\"cp-dx\" href=\"#conditions/PSYCHIATRY/Depressive%20Disorders\">depressive disorders</a>). Screen for <b>bipolarity</b> (a past &ldquo;high&rdquo;) before prescribing (see <a class=\"cp-dx\" href=\"#conditions/PSYCHIATRY/Bipolar%20Affective%20Disorder\">bipolar disorder</a>), and think of <b>postnatal depression</b> (and puerperal psychosis) in the perinatal period.</span></div><div style=\"font-size:22px;\"><div style=\"font-size:22px;\">📷</div><div style=\"font-size:12.5px;font-weight:700;\">Image placeholder &mdash; low mood: FIRST assess suicide risk (ideation / plan / intent / means). Then depression (low mood + anhedonia + low energy &ge;2 weeks): unipolar vs bipolar (ask about past mania). Exclude organic (hypothyroid, anaemia / B12, drugs / alcohol, Cushing&rsquo;s, Parkinson&rsquo;s). Consider bereavement / adjustment</div><div style=\"font-family:var(--mono);font-size:10.5px;text-transform:uppercase;letter-spacing:.05em;color:var(--rn-muted,#9AA4B2);margin-top:10px;\">link to be uploaded</div></div><div class=\"cp-step\" id=\"s-1\"><div class=\"cp-step-h\"><span class=\"cp-num\">1</span><span class=\"cp-title\">Confirm &amp; classify</span></div><div class=\"cp-step-body\"><div class=\"cp-killgrid\"><div class=\"cp-kill\" style=\"--kc:var(--rn-red,#C93535);--kcb:var(--rn-red-bg,#FDEAEA);\"><div class=\"cp-kill-top\"><span class=\"cp-kill-ic\">🚩</span><span class=\"cp-kill-name\">Suicide / self-harm risk</span></div><div class=\"cp-kill-desc\"><ul style=\"margin:6px 0 0;padding-left:17px;list-style:disc;\"><li style=\"margin:3px 0;\">Ask directly: <b>ideation, plan, intent, means</b>, previous attempts, protective factors</li><li style=\"margin:3px 0;\">Command hallucinations, hopelessness, impulsivity raise risk &rarr; <b>risk assessment + safety plan</b> (see <a class=\"cp-dx\" href=\"#signs/PSYCHIATRIC/Self-Harm%20%26%20Suicidal%20Ideation\">self-harm &amp; suicidal ideation</a>, <a class=\"cp-dx\" href=\"#conditions/PSYCHIATRY/Self-Harm%20%26%20Suicide%20Risk\">self-harm &amp; suicide risk</a>)</li><li style=\"margin:3px 0;\">Consider urgent psychiatry / admission</li></ul></div></div><div class=\"cp-kill\" style=\"--kc:var(--rn-red,#C93535);--kcb:var(--rn-red-bg,#FDEAEA);\"><div class=\"cp-kill-top\"><span class=\"cp-kill-ic\">🚩</span><span class=\"cp-kill-name\">Psychotic / severe depression</span></div><div class=\"cp-kill-desc\"><ul style=\"margin:6px 0 0;padding-left:17px;list-style:disc;\"><li style=\"margin:3px 0;\"><b>Mood-congruent delusions</b> (guilt, poverty, nihilism / <b>Cotard&rsquo;s</b>), hallucinations</li><li style=\"margin:3px 0;\"><b>Catatonia</b>, stupor, <b>severe self-neglect / dehydration</b> &rarr; urgent assessment &plusmn; ECT (see <a class=\"cp-dx\" href=\"#conditions/PSYCHIATRY/Depressive%20Disorders\">depressive disorders</a>)</li><li style=\"margin:3px 0;\">A psychiatric emergency</li></ul></div></div><div class=\"cp-kill\" style=\"--kc:var(--rn-amber,#B86B00);--kcb:var(--rn-amber-bg,#FEF5E4);\"><div class=\"cp-kill-top\"><span class=\"cp-kill-ic\">🟠</span><span class=\"cp-kill-name\">Bipolar depression</span></div><div class=\"cp-kill-desc\"><ul style=\"margin:6px 0 0;padding-left:17px;list-style:disc;\"><li style=\"margin:3px 0;\">A <b>past episode of mania / hypomania</b> (elevated mood, reduced need for sleep, overspending, grandiosity)</li><li style=\"margin:3px 0;\"><b>Antidepressant monotherapy can trigger a switch</b> &mdash; screen before prescribing (see <a class=\"cp-dx\" href=\"#conditions/PSYCHIATRY/Bipolar%20Affective%20Disorder\">bipolar disorder</a>, <a class=\"cp-dx\" href=\"#signs/PSYCHIATRIC/Mania\">mania</a>)</li><li style=\"margin:3px 0;\">Needs a mood stabiliser-based plan</li></ul></div></div><div class=\"cp-kill\" style=\"--kc:var(--rn-amber,#B86B00);--kcb:var(--rn-amber-bg,#FEF5E4);\"><div class=\"cp-kill-top\"><span class=\"cp-kill-ic\">🟠</span><span class=\"cp-kill-name\">Organic cause</span></div><div class=\"cp-kill-desc\"><ul style=\"margin:6px 0 0;padding-left:17px;list-style:disc;\"><li style=\"margin:3px 0;\"><b>Hypothyroidism</b>, anaemia / <b>B12 deficiency</b>, <b>Cushing&rsquo;s</b>, Parkinson&rsquo;s, dementia, occult cancer (see <a class=\"cp-dx\" href=\"#conditions/ENDOCRINOLOGY/Hypothyroidism\">hypothyroidism</a>, <a class=\"cp-dx\" href=\"#conditions/HAEMATOLOGY/Anaemia%20%28micro%2Fnormo%2Fmacrocytic%29\">anaemia</a>)</li><li style=\"margin:3px 0;\"><b>Drugs / alcohol</b> &mdash; steroids, beta-blockers, interferon, <b>alcohol</b> (see <a class=\"cp-dx\" href=\"#conditions/PSYCHIATRY/Substance%20Use%20Disorder\">substance use</a>)</li><li style=\"margin:3px 0;\">Check TFTs, FBC, B12 / folate, glucose, calcium</li></ul></div></div><div class=\"cp-kill\" style=\"--kc:var(--rn-blue,#3B7DD8);--kcb:var(--rn-blue-bg,#EBF2FF);\"><div class=\"cp-kill-top\"><span class=\"cp-kill-ic\">🩹</span><span class=\"cp-kill-name\">Unipolar depression</span></div><div class=\"cp-kill-desc\"><ul style=\"margin:6px 0 0;padding-left:17px;list-style:disc;\"><li style=\"margin:3px 0;\"><b>Low mood + anhedonia + low energy for &ge;2 weeks</b></li><li style=\"margin:3px 0;\">Plus sleep / appetite / concentration / guilt / worthlessness changes (see <a class=\"cp-dx\" href=\"#conditions/PSYCHIATRY/Depressive%20Disorders\">depressive disorders</a>)</li><li style=\"margin:3px 0;\">Grade severity (e.g. PHQ-9); the commonest cause</li></ul></div></div><div class=\"cp-kill\" style=\"--kc:var(--rn-blue,#3B7DD8);--kcb:var(--rn-blue-bg,#EBF2FF);\"><div class=\"cp-kill-top\"><span class=\"cp-kill-ic\">🩹</span><span class=\"cp-kill-name\">Bereavement / adjustment</span></div><div class=\"cp-kill-desc\"><ul style=\"margin:6px 0 0;padding-left:17px;list-style:disc;\"><li style=\"margin:3px 0;\"><b>Grief</b> &mdash; proportionate to a loss, comes in waves, preserved self-worth</li><li style=\"margin:3px 0;\"><b>Adjustment disorder</b> after a stressor; seasonal affective disorder</li><li style=\"margin:3px 0;\">Comorbid <b>anxiety</b> is common (see <a class=\"cp-dx\" href=\"#signs/PSYCHIATRIC/Anxiety\">anxiety</a>)</li></ul></div></div></div><div class=\"cp-pearl\"><b>Risk, then bipolar, then organic.</b> Always assess <b>suicide risk</b>; always ask about a <b>past high</b> (bipolar) before prescribing an antidepressant; and always <b>exclude organic causes</b> (thyroid, anaemia, drugs / alcohol) of low mood.</div></div></div><div class=\"cp-step\" id=\"s-2\"><div class=\"cp-step-h\"><span class=\"cp-num\">2</span><span class=\"cp-title\">What it points to</span></div><div class=\"cp-step-body\"><div class=\"cp-clues\"><div class=\"cp-clue\"><div class=\"cp-when\"><b>Low mood + suicidal thoughts with a plan / intent / means</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#signs/PSYCHIATRIC/Self-Harm%20%26%20Suicidal%20Ideation\">Suicide risk (assess + safety)</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Low mood + delusions of guilt / nihilism (Cotard&rsquo;s) or catatonia</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/PSYCHIATRY/Depressive%20Disorders\">Psychotic / severe depression</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Low mood + a past &ldquo;high&rdquo; (reduced sleep, overspending, grandiosity)</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/PSYCHIATRY/Bipolar%20Affective%20Disorder\">Bipolar depression</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Low mood + fatigue + weight gain + cold intolerance</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/ENDOCRINOLOGY/Hypothyroidism\">Hypothyroidism</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Low mood + fatigue + pallor + microcytic anaemia</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/HAEMATOLOGY/Anaemia%20%28micro%2Fnormo%2Fmacrocytic%29\">Anaemia / B12 deficiency</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Low mood + heavy or dependent alcohol use</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/PSYCHIATRY/Substance%20Use%20Disorder\">Substance-related depression</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Low mood + anhedonia + low energy for &ge;2 weeks, no red flags</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#conditions/PSYCHIATRY/Depressive%20Disorders\">Unipolar depression</a></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Low mood after a major loss, in waves, self-worth preserved</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><span class=\"cp-dx cp-dx-off\">Bereavement / grief</span></div></div><div class=\"cp-clue\"><div class=\"cp-when\"><b>Low mood + excessive worry + panic attacks</b></div><div class=\"cp-arrow\">&rarr;</div><div class=\"cp-then\"><a class=\"cp-dx\" href=\"#signs/PSYCHIATRIC/Anxiety\">Comorbid anxiety</a></div></div></div><div class=\"cp-pearl\"><b>Ask the two questions everyone forgets.</b> &ldquo;Have you had thoughts of ending your life?&rdquo; and &ldquo;Have you ever had a period of feeling unusually high / not needing sleep?&rdquo; &mdash; the first sets the <b>risk</b>, the second reveals <b>bipolarity</b>.</div></div></div><div class=\"cp-step\" id=\"s-3\"><div class=\"cp-step-h\"><span class=\"cp-num\">3</span><span class=\"cp-title\">Assess &amp; act</span></div><div class=\"cp-step-body\"><div class=\"cp-sub\">At the bedside &mdash; the risk, the mental state, the past &ldquo;high&rdquo;, the organic screen</div><div class=\"cp-bed\"><div class=\"cp-bed-h\"><span class=\"cp-bed-n\">History &amp; red flags</span></div><div class=\"cp-reads\"><span class=\"cp-read\"><b>Core symptoms</b> (mood, anhedonia, energy) + duration; <b>biological</b> (sleep, appetite, weight, libido) and <b>cognitive</b> (guilt, worthlessness, concentration) features; <b>suicidal ideation / plan</b>; <b>past mania</b>; alcohol / drugs; thyroid / anaemia symptoms; perinatal; recent loss / stressor</span></div></div><div class=\"cp-bed cp-bed-hot\"><div class=\"cp-bed-h\"><span class=\"cp-bed-n\">Examine</span></div><div class=\"cp-reads\"><span class=\"cp-read\">A focused <b>mental state examination</b> &mdash; appearance / behaviour, speech, <b>mood and affect</b>, thought content (guilt / nihilism / suicidal), perception (hallucinations), cognition and insight; look for <b>psychomotor retardation</b>, self-neglect, and physical signs of an organic cause (thyroid, pallor)</span></div></div><div class=\"cp-bed\"><div class=\"cp-bed-h\"><span class=\"cp-bed-n\">Investigate</span></div><div class=\"cp-reads\"><span class=\"cp-read\">Screen for organic causes: <b>TFTs, FBC, B12 / folate, U&amp;E, calcium, glucose / HbA1c, LFTs</b> (&plusmn; drug review); use a validated tool (<b>PHQ-9</b>); a formal <b>risk assessment</b>; collateral history for bipolarity</span></div></div><div class=\"cp-bed\"><div class=\"cp-bed-h\"><span class=\"cp-bed-n\">Act</span></div><div class=\"cp-reads\"><span class=\"cp-read\"><b>Manage risk first</b> (safety plan &plusmn; urgent psychiatry / admission); for depression, offer <b>psychological therapy</b> (and an <b>antidepressant</b> for moderate&ndash;severe), treating <b>bipolar depression</b> with a mood-stabiliser-based plan (not antidepressant monotherapy); <b>treat the organic cause</b>; and support bereavement / adjustment</span></div></div><div class=\"cp-sub\">Then &mdash; confirm the cause</div><div class=\"cp-confirm\"><span class=\"cp-cfm\"><span class=\"cp-dxn\">Suicide risk</span> <span class=\"cp-ar\">&rarr;</span> <span class=\"cp-tst\"><b>risk assessment</b></span></span><span class=\"cp-cfm\"><span class=\"cp-dxn\">Psychotic depression</span> <span class=\"cp-ar\">&rarr;</span> <span class=\"cp-tst\"><b>mental state exam</b> (urgent psychiatry)</span></span><span class=\"cp-cfm\"><span class=\"cp-dxn\">Bipolar depression</span> <span class=\"cp-ar\">&rarr;</span> <span class=\"cp-tst\"><b>collateral history of mania</b></span></span><span class=\"cp-cfm\"><span class=\"cp-dxn\">Organic cause</span> <span class=\"cp-ar\">&rarr;</span> <span class=\"cp-tst\"><b>TFTs / FBC / B12 / calcium</b></span></span><span class=\"cp-cfm\"><span class=\"cp-dxn\">Unipolar depression</span> <span class=\"cp-ar\">&rarr;</span> <span class=\"cp-tst\"><b>clinical</b> (PHQ-9)</span></span><span class=\"cp-cfm\"><span class=\"cp-dxn\">Bereavement</span> <span class=\"cp-ar\">&rarr;</span> <span class=\"cp-tst\"><b>clinical</b></span></span></div><div class=\"cp-pearl\"><b>The rules that carry it:</b> <b>assess suicide risk in everyone</b>; <b>screen for bipolarity</b> before prescribing; <b>exclude organic causes</b>. Treat depression with therapy &plusmn; an antidepressant, and manage <b>bipolar depression differently</b>.</div></div></div><div class=\"cp-hand\" id=\"s-hand\"><span>➡️</span><span>Landed on a diagnosis? Open its <b>note</b> for investigations, management &amp; prognosis &mdash; every blue link above jumps straight there. <b>This is where the conditions library takes over.</b></span></div><div class=\"cp-step\" id=\"s-map\"><div class=\"cp-step-h\"><span class=\"cp-mapic\">🗺️</span><span class=\"cp-title\">In summary</span></div><div class=\"cp-step-body\"><div class=\"cp-flow\"><div class=\"cp-node start\">LOW MOOD &mdash; FIRST assess suicide risk (ideation / plan / intent / means)</div><div class=\"cp-dn\">▼</div><div class=\"cp-node danger\">Red flags: active suicidal plan / intent &rarr; safety + urgent psychiatry &middot; psychotic / severe depression (delusions, catatonia, self-neglect) &middot; puerperal psychosis</div><div class=\"cp-dn\">▼</div><div class=\"cp-node decision\">Screen for BIPOLARITY (a past high) before prescribing &mdash; bipolar depression is NOT treated with antidepressant monotherapy</div><div class=\"cp-dn\">▼</div><div class=\"cp-node decision\">Exclude ORGANIC: hypothyroidism, anaemia / B12, drugs / alcohol, Cushing&rsquo;s, Parkinson&rsquo;s, dementia, occult cancer &middot; consider bereavement / adjustment</div><div class=\"cp-dn\">▼</div><div class=\"cp-branchbox\"><div class=\"cp-branchcols\"><div class=\"cp-col\"><div class=\"cp-feat\">Suicidal ideation + plan / intent</div><div class=\"cp-cdn\">▼</div><a href=\"#signs/PSYCHIATRIC/Self-Harm%20%26%20Suicidal%20Ideation\" class=\"cp-dx-node tier-red cp-dxlink\">Suicide risk</a><div class=\"cp-cdn\">▼</div><div class=\"cp-test\">risk assessment</div></div><div class=\"cp-col\"><div class=\"cp-feat\">Delusions / catatonia / self-neglect</div><div class=\"cp-cdn\">▼</div><a href=\"#conditions/PSYCHIATRY/Depressive%20Disorders\" class=\"cp-dx-node tier-red cp-dxlink\">Psychotic / severe depression</a><div class=\"cp-cdn\">▼</div><div class=\"cp-test\">urgent psychiatry</div></div><div class=\"cp-col\"><div class=\"cp-feat\">Past mania / hypomania</div><div class=\"cp-cdn\">▼</div><a href=\"#conditions/PSYCHIATRY/Bipolar%20Affective%20Disorder\" class=\"cp-dx-node tier-amber cp-dxlink\">Bipolar depression</a><div class=\"cp-cdn\">▼</div><div class=\"cp-test\">collateral</div></div><div class=\"cp-col\"><div class=\"cp-feat\">Fatigue + weight gain / pallor</div><div class=\"cp-cdn\">▼</div><a href=\"#conditions/ENDOCRINOLOGY/Hypothyroidism\" class=\"cp-dx-node tier-amber cp-dxlink\">Organic cause</a><div class=\"cp-cdn\">▼</div><div class=\"cp-test\">TFTs / FBC</div></div><div class=\"cp-col\"><div class=\"cp-feat\">Core low mood &ge;2 weeks, no red flags</div><div class=\"cp-cdn\">▼</div><a href=\"#conditions/PSYCHIATRY/Depressive%20Disorders\" class=\"cp-dx-node tier-green cp-dxlink\">Unipolar depression</a><div class=\"cp-cdn\">▼</div><div class=\"cp-test\">PHQ-9</div></div></div></div><div class=\"cp-dn\">▼</div><div class=\"cp-node work\">Risk assessment + mental state exam &middot; PHQ-9 &middot; TFTs / FBC / B12 / folate / U&amp;E / calcium / glucose / LFTs &middot; drug review &middot; collateral for bipolarity</div><div class=\"cp-dn\">▼</div><div class=\"cp-node final\">➡️ Open the condition note &mdash; manage risk first; psychological therapy &plusmn; antidepressant for depression; mood-stabiliser plan for bipolar depression; treat the organic cause; support grief / adjustment</div></div></div></div></div>"}